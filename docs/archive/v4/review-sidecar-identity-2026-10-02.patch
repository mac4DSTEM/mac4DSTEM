+//
+//  ReviewSidecarIdentityTests.swift
+//  Lane B (Slot 4¾ pre-release review, 2026-10-02, finding a2): a session sidecar says which source it belongs to,
+//  and a sidecar of another source is refused on restore instead of silently adopted.
+//
+
+import XCTest
+import DSTEMCore
+import DSTEMSession
+@testable import mac4DSTEM
+
+@MainActor
+final class ReviewSidecarIdentityTests: XCTestCase {
+
+    private func scratchDirectory() throws -> URL {
+        let directory = FileManager.default.temporaryDirectory
+            .appendingPathComponent("ReviewSidecarIdentity-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        addTeardownBlock { try? FileManager.default.removeItem(at: directory) }
+        return directory
+    }
+
+    private func peaks(scanWidth: Int, scanHeight: Int) -> BraggVectors {
+        var grid = [[BraggPeak]](repeating: [], count: scanWidth * scanHeight)
+        for index in grid.indices { grid[index] = [BraggPeak(x: 3, y: 4, intensity: 1)] }
+        return BraggVectors(scanWidth: scanWidth, scanHeight: scanHeight, peaks: grid,
+                            detectionProvenance: [:])
+    }
+
+    /// The demo source (12 × 12 scan, 64 × 64 detector), opened with `sidecar` as its session file.
+    private func openDemo(with sidecar: URL,
+                          specification: LoadSpecification = .fullExtent) async throws -> AppState {
+        let suite = "ReviewSidecarIdentity-\(UUID().uuidString)"
+        let defaults = try XCTUnwrap(UserDefaults(suiteName: suite))
+        addTeardownBlock { UserDefaults().removePersistentDomain(forName: suite) }
+        let locator = SessionSidecarLocator(defaults: defaults)
+        let source = DemoFourDDataSource(includesCalibration: false)
+        let descriptor = try await source.discoverPrimaryDataset()
+        locator.adopt(sidecar, for: descriptor)
+        let state = AppState(sessionSidecar: locator)
+        let load = state.beginDatasetLoading("Opening demo…")
+        await state.activate(descriptor: descriptor, reader: source,
+                             specification: specification, runInitialAnalysis: false)
+        state.finishDatasetLoading(owner: load)
+        return state
+    }
+
+    private let foreignCalibration = PixelCalibration(qSize: 0.0123, qUnits: "A^-1",
+                                                      qx0Mean: 64, qy0Mean: 64)
+
+    // MARK: Experiment (Gate D) — runs against HEAD's API
+
+    /// A legacy (unstamped) sidecar whose peaks sit on a 128 × 128 detector cannot belong to a 64 × 64 file.
+    func testExperimentLegacySidecarWithALargerDetectorIsRefusedWhole() async throws {
+        let sidecar = try scratchDirectory().appendingPathComponent("demo.mac4dstem.h5")
+        try BraggVectorEMDWriter.write(vectors: peaks(scanWidth: 12, scanHeight: 12),
+                                       qWidth: 128, qHeight: 128,
+                                       calibration: PixelCalibration(), to: sidecar)
+        try BraggVectorEMDWriter.mergeCalibration(foreignCalibration, qWidth: 128, qHeight: 128, to: sidecar)
+        let state = try await openDemo(with: sidecar)
+        XCTAssertNil(state.calibrationSession.calibration.qPixelSize,
+                     "adopted Q pixel size: \(String(describing: state.calibrationSession.calibration.qPixelSize))")
+        XCTAssertEqual(state.gates.sidecarRestoreFailure?.kind, .doesNotFit,
+                       "gate: \(String(describing: state.gates.sidecarRestoreFailure))")
+        XCTAssertFalse(state.gates.mayWriteSidecar)
+    }
+
+    /// A legacy calibration-only sidecar proves nothing about its source: behaviour as before (adopted).
+    func testExperimentLegacyCalibrationOnlySidecarIsStillAdopted() async throws {
+        let sidecar = try scratchDirectory().appendingPathComponent("demo.mac4dstem.h5")
+        try BraggVectorEMDWriter.mergeCalibration(foreignCalibration, qWidth: 64, qHeight: 64, to: sidecar)
+        let state = try await openDemo(with: sidecar)
+        XCTAssertEqual(try XCTUnwrap(state.calibrationSession.calibration.qPixelSize), 0.0123, accuracy: 1e-12)
+        XCTAssertNil(state.gates.sidecarRestoreFailure)
+        XCTAssertTrue(state.gates.mayWriteSidecar)
+    }
+
+    // MARK: The restore policy (pure)
+
+    private let dm4 = SessionSourceIdentity(fileName: "scan.dm4", shape: [12, 12, 128, 128])
+    private let h5 = SessionSourceIdentity(fileName: "scan.h5", shape: [12, 12, 64, 64])
+
+    /// Mutation: drop the shape guard in `SessionSourcePolicy.decide` -> red.
+    func testAStampOfAnotherShapeIsRefusedNamingBothFiles() {
+        guard case .refuse(let reason) = SessionSourcePolicy.decide(
+            recorded: dm4, storedPeakShape: nil, opened: h5) else {
+            return XCTFail("a 128 × 128 session must not restore onto a 64 × 64 file")
+        }
+        XCTAssertTrue(reason.contains("scan.dm4") && reason.contains("scan.h5"), reason)
+    }
+
+    /// Same native shape, other name: a renamed file — restored, with a note naming both.
+    /// Mutation: compare names before shapes and refuse on a name mismatch -> red.
+    func testASameShapeStampUnderAnotherNameRestoresWithANote() {
+        let renamed = SessionSourceIdentity(fileName: "scan renamed.h5", shape: h5.shape)
+        guard case .adoptRenamed(let note) = SessionSourcePolicy.decide(
+            recorded: h5, storedPeakShape: nil, opened: renamed) else {
+            return XCTFail("a renamed file of the same shape restores")
+        }
+        XCTAssertTrue(note.contains("scan.h5") && note.contains("scan renamed.h5"), note)
+        XCTAssertEqual(SessionSourcePolicy.decide(recorded: h5, storedPeakShape: nil, opened: h5), .adopt)
+    }
+
+    /// Unstamped: only a peak grid LARGER than the file on some axis is proof; a crop/bin-sized or equal one is not.
+    /// Mutation: `>` -> `!=` in the legacy branch -> red (the binned grid is refused).
+    func testAnUnstampedSidecarIsRefusedOnlyOnALargerPeakGrid() {
+        if case .refuse = SessionSourcePolicy.decide(recorded: nil, storedPeakShape: [12, 12, 128, 128], opened: h5) {} else {
+            XCTFail("a 128 × 128 grid cannot belong to a 64 × 64 file")
+        }
+        if case .refuse = SessionSourcePolicy.decide(recorded: nil, storedPeakShape: [13, 12, 64, 64], opened: h5) {} else {
+            XCTFail("a 13-row scan cannot belong to a 12-row file")
+        }
+        XCTAssertEqual(SessionSourcePolicy.decide(recorded: nil, storedPeakShape: [6, 12, 32, 32], opened: h5), .adopt,
+                       "a cropped, binned view's grid is smaller — no proof")
+        XCTAssertEqual(SessionSourcePolicy.decide(recorded: nil, storedPeakShape: h5.shape, opened: h5), .adopt)
+        XCTAssertEqual(SessionSourcePolicy.decide(recorded: nil, storedPeakShape: nil, opened: h5), .adopt,
+                       "a calibration-only legacy file proves nothing")
+        XCTAssertEqual(SessionSourcePolicy.decide(recorded: h5, storedPeakShape: [12, 12, 128, 128], opened: h5), .adopt,
+                       "a stamp, once present, is the evidence")
+    }
+
+    // MARK: The writer round trip
+
+    /// The stamp is written, read back, and carried forward by a save that names no source.
+    /// Mutation: drop the carry-forward (`sourceIdentityJSON = existingJSON`) in writeFile -> red.
+    func testTheStampRoundTripsAndSurvivesASaveThatNamesNoSource() throws {
+        let sidecar = try scratchDirectory().appendingPathComponent("scan.mac4dstem.h5")
+        try BraggVectorEMDWriter.mergeCalibration(foreignCalibration, qWidth: 128, qHeight: 128, to: sidecar,
+                                                  sourceIdentity: dm4)
+        XCTAssertEqual(try BraggVectorEMDWriter.loadSession(from: sidecar).sourceIdentity, dm4)
+        try BraggVectorEMDWriter.mergeCalibration(foreignCalibration, qWidth: 128, qHeight: 128, to: sidecar)
+        XCTAssertEqual(try BraggVectorEMDWriter.loadSession(from: sidecar).sourceIdentity, dm4,
+                       "a save that says nothing about its source must not erase the stamp")
+    }
+
+    /// A save for a source of another shape over a stamped file is refused, and the file is untouched.
+    /// Mutation: delete the throw in writeFile's stamp check -> red.
+    func testASaveForASourceOfAnotherShapeIsRefusedAndTheFileIsUntouched() throws {
+        let sidecar = try scratchDirectory().appendingPathComponent("scan.mac4dstem.h5")
+        try BraggVectorEMDWriter.mergeCalibration(foreignCalibration, qWidth: 128, qHeight: 128, to: sidecar,
+                                                  sourceIdentity: dm4)
+        let before = try Data(contentsOf: sidecar)
+        XCTAssertThrowsError(try BraggVectorEMDWriter.mergeCalibration(
+            PixelCalibration(qSize: 0.0246), qWidth: 64, qHeight: 64, to: sidecar, sourceIdentity: h5)) { error in
+            let text = error.localizedDescription
+            XCTAssertTrue(text.contains("scan.dm4") && text.contains("scan.h5"), text)
+        }
+        XCTAssertEqual(try Data(contentsOf: sidecar), before)
+        // Same shape under another name re-stamps (a renamed file).
+        let renamed = SessionSourceIdentity(fileName: "scan renamed.dm4", shape: dm4.shape)
+        try BraggVectorEMDWriter.mergeCalibration(foreignCalibration, qWidth: 128, qHeight: 128, to: sidecar,
+                                                  sourceIdentity: renamed)
+        XCTAssertEqual(try BraggVectorEMDWriter.loadSession(from: sidecar).sourceIdentity, renamed)
+    }
+
+    /// The unstamped evidence: the peak grid's Rshape + Qshape reach the snapshot.
+    /// Mutation: leave `storedPeakShape` unset in loadSession -> red.
+    func testTheStoredPeakShapeReachesTheSnapshot() throws {
+        let sidecar = try scratchDirectory().appendingPathComponent("scan.mac4dstem.h5")
+        try BraggVectorEMDWriter.write(vectors: peaks(scanWidth: 5, scanHeight: 3), qWidth: 40, qHeight: 30,
+                                       calibration: PixelCalibration(), to: sidecar)
+        XCTAssertEqual(try BraggVectorEMDWriter.loadSession(from: sidecar).storedPeakShape, [3, 5, 30, 40])
+        let calibrationOnly = try scratchDirectory().appendingPathComponent("c.mac4dstem.h5")
+        try BraggVectorEMDWriter.mergeCalibration(foreignCalibration, qWidth: 8, qHeight: 8, to: calibrationOnly)
+        XCTAssertNil(try BraggVectorEMDWriter.loadSession(from: calibrationOnly).storedPeakShape)
+    }
+
+    // MARK: The restore, end to end (demo: "mac4DSTEM Demo.h5", 12 × 12 scan, 64 × 64 detector)
+
+    private var demo: SessionSourceIdentity { SessionSourceIdentity(source: DemoFourDDataSource.descriptor) }
+
+    /// The reviewer's scenario: the sibling's stamped session (bin_Q(2) apart) is refused whole and saves are disabled.
+    /// Mutation: make loadSessionSnapshot ignore `.refuse` -> red.
+    func testAStampedSessionOfASiblingIsRefusedWholeAndSavesAreDisabled() async throws {
+        let sidecar = try scratchDirectory().appendingPathComponent("demo.mac4dstem.h5")
+        let sibling = SessionSourceIdentity(fileName: "mac4DSTEM Demo.dm4", shape: [12, 12, 128, 128])
+        try BraggVectorEMDWriter.mergeCalibration(foreignCalibration, qWidth: 128, qHeight: 128, to: sidecar,
+                                                  sourceIdentity: sibling)
+        let state = try await openDemo(with: sidecar)
+        XCTAssertNil(state.calibrationSession.calibration.qPixelSize, "the sibling's Q scale must not be adopted")
+        XCTAssertEqual(state.gates.sidecarRestoreFailure?.kind, .doesNotFit)
+        XCTAssertTrue(state.gates.sidecarRestoreFailure?.message.contains("mac4DSTEM Demo.dm4") == true)
+        XCTAssertFalse(state.gates.mayWriteSidecar)
+        XCTAssertFalse(state.sessionInventory.hasSidecar, "nothing from the sidecar is adopted")
+    }
+
+    /// The legitimate reopens: the same file whole, binned, and cropped (recorded = loaded), from a sidecar in another
+    /// folder than the source (a moved folder: the path differs, the name does not). None may be refused.
+    /// Mutation: stamp/check the VIEW's shape (`descriptor`) instead of `loadView.source` -> red (the binned reopen).
+    func testTheSameFileReopenedWholeBinnedOrCroppedStillRestores() async throws {
+        let crop = LoadSpecification(scanCrop: AxisCrop(yOffset: 2, xOffset: 1, height: 6, width: 8))
+        let cases: [(recorded: LoadSpecification, loaded: LoadSpecification)] = [
+            (.fullExtent, .fullExtent),
+            (.fullExtent, LoadSpecification(detectorBin: 2)),
+            (crop, crop),
+        ]
+        for (recorded, loaded) in cases {
+            let sidecar = try scratchDirectory().appendingPathComponent("demo.mac4dstem.h5")
+            try BraggVectorEMDWriter.mergeCalibration(foreignCalibration, qWidth: 64, qHeight: 64, to: sidecar,
+                                                      loadSpecification: recorded, sourceIdentity: demo)
+            let state = try await openDemo(with: sidecar, specification: loaded)
+            XCTAssertNil(state.gates.sidecarRestoreFailure, "recorded \(recorded), loaded \(loaded)")
+            XCTAssertTrue(state.gates.mayWriteSidecar)
+            XCTAssertNotNil(state.calibrationSession.calibration.qPixelSize, "recorded \(recorded), loaded \(loaded)")
+        }
+    }
+
+    /// A renamed file of the same shape restores, and the log names both files.
+    /// Mutation: drop the `.adoptRenamed` status line in loadSessionSnapshot -> red.
+    func testARenamedFileRestoresAndTheLogNamesBothFiles() async throws {
+        let sidecar = try scratchDirectory().appendingPathComponent("demo.mac4dstem.h5")
+        let before = SessionSourceIdentity(fileName: "Demo before rename.h5", shape: demo.shape)
+        try BraggVectorEMDWriter.mergeCalibration(foreignCalibration, qWidth: 64, qHeight: 64, to: sidecar,
+                                                  sourceIdentity: before)
+        let state = try await openDemo(with: sidecar)
+        XCTAssertEqual(try XCTUnwrap(state.calibrationSession.calibration.qPixelSize), 0.0123, accuracy: 1e-12)
+        XCTAssertNil(state.gates.sidecarRestoreFailure)
+        XCTAssertTrue(state.activityLog.messages.contains {
+            $0.contains("Demo before rename.h5") && $0.contains("mac4DSTEM Demo.h5")
+        }, "log: \(state.activityLog.messages.suffix(8))")
+    }
