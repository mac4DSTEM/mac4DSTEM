--- /dev/null
+++ b/mac4DSTEMTests/ACOMSubBinAzimuthDepositionTests.swift
@@ -0,0 +1,62 @@
+import XCTest
+import DSTEMCore
+
+/// Lane SB (2026-10-01). `OrientationPlan.buildPolar` used to round every
+/// spot's azimuth to the NEAREST bin; py4DSTEM keeps the sub-bin position
+/// (linear interpolation, crystal_ACOM.py:800-818). With the mirror pass
+/// doubling the candidates, the discarded half bin (1.4 deg at 128 bins)
+/// outweighed the Friedel penalty and Au trials fell into the half-turn class.
+final class ACOMSubBinAzimuthDepositionTests: XCTestCase {
+
+    private let geo = PolarGeometry(nRadial: 4, nAzimuthal: 128, radialScale: 0.1)
+
+    private func ringImage(bins: Double, blur: Double) -> [Float] {
+        // Radius 0.2 = ring 2 exactly.
+        let img = OrientationPlan.buildPolar(
+            spots: [(r: 0.2, azim: bins / 128 * 2 * .pi, weight: 1)], geometry: geo,
+            azimBlurBins: blur, radialKernelInvAngstrom: 0)
+        return Array(img[(2 * 128)..<(3 * 128)])
+    }
+
+    /// Circular centroid of the ring's positive excess, in bins.
+    private func centroid(_ ring: [Float]) -> Double {
+        var c = 0.0, s = 0.0
+        for (i, v) in ring.enumerated() where v > 0 {
+            let a = Double(i) / 128 * 2 * .pi
+            c += Double(v) * cos(a); s += Double(v) * sin(a)
+        }
+        var a = atan2(s, c); if a < 0 { a += 2 * .pi }
+        return a / (2 * .pi) * 128
+    }
+
+    /// A spot half way between two bins is shared equally.
+    func testDepositionIsLinearBetweenBins() {
+        let ring = ringImage(bins: 10.5, blur: 0)
+        XCTAssertEqual(ring[10], ring[11], accuracy: 1e-6)
+        XCTAssertGreaterThan(ring[10], 0.4 * ring.max()!, "both neighbours must carry the spot")
+    }
+
+    /// The deposited position follows the exact azimuth, blurred or not.
+    func testCentroidFollowsTheExactAzimuth() {
+        for blur in [0.0, 1.5] {
+            for frac in [0.0, 0.25, 0.5, 0.75] {
+                XCTAssertEqual(centroid(ringImage(bins: 40 + frac, blur: blur)), 40 + frac,
+                               accuracy: 0.02, "blur \(blur) fraction \(frac)")
+            }
+        }
+    }
+
+    /// Wrap-around: a spot just under 2 pi lands across bin 127 and bin 0.
+    func testDepositionWrapsAcrossTheSeam() {
+        let ring = ringImage(bins: 127.5, blur: 0)
+        XCTAssertEqual(ring[127], ring[0], accuracy: 1e-6)
+        XCTAssertGreaterThan(ring[0], 0.4 * ring.max()!)
+    }
+
+    /// A bin-centre spot is a single-bin deposit, as before: on-grid cases are unchanged.
+    func testBinCentreSpotIsASingleBin() {
+        let ring = ringImage(bins: 40, blur: 0)
+        XCTAssertEqual(ring[40], 1 - 1 / 128, accuracy: 1e-6)
+        XCTAssertEqual(ring[41], -1 / 128, accuracy: 1e-6)
+    }
+}
