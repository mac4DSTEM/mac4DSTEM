+/// Whether a session sidecar belongs to the file being opened (Slot 4¾ review
+/// finding a2, 2026-10-02). Two sources in one folder (`scan.dm4` and
+/// py4DSTEM's `scan.h5`, often `bin_Q(2)`) share one sidecar path, and the
+/// calibration policy above adopts a whole-file record onto a whole-file load
+/// verbatim — a Q scale off by the bin factor, an origin in the other
+/// detector's pixels, and the other dataset's results and recipe adopted as
+/// this one's. Asked BEFORE anything is restored. Pure, so each branch is
+/// unit-pinned (ReviewSidecarIdentityTests).
+package nonisolated enum SessionSourcePolicy: Equatable {
+    /// The sidecar names this file, or (unstamped) proves nothing against it.
+    case adopt
+    /// Same native shape, another file name — a renamed file. Adopted; the
+    /// note names both files so the reader can judge.
+    case adoptRenamed(note: String)
+    /// The sidecar provably belongs to another source: nothing is restored.
+    case refuse(reason: String)
+
+    /// `recorded` is the sidecar's stamp (nil on a file written before it);
+    /// `storedPeakShape` its peak grid's `[ry, rx, qy, qx]` (nil when none);
+    /// `opened` the identity of the FILE being opened (`LoadView.source`).
+    package static func decide(
+        recorded: SessionSourceIdentity?, storedPeakShape: [Int]?,
+        opened: SessionSourceIdentity
+    ) -> SessionSourcePolicy {
+        if let recorded {
+            guard recorded.shape == opened.shape else {
+                return .refuse(reason:
+                    "The session file was saved for \(recorded.fileName), a \(recorded.shapeSummary); "
+                    + "this file, \(opened.fileName), is a \(opened.shapeSummary). "
+                    + "Its calibration, results and recipe belong to that dataset, so nothing was restored.")
+            }
+            guard recorded.fileName == opened.fileName else {
+                return .adoptRenamed(note:
+                    "The session file was saved for \(recorded.fileName); it was restored onto "
+                    + "\(opened.fileName), which has the same shape (\(opened.shapeSummary)).")
+            }
+            return .adopt
+        }
+        // UNSTAMPED: the only shape such a file records is its peak grid's,
+        // written on some crop or bin of its OWN source — so no axis of it can
+        // exceed that source's. A larger axis is proof of another file; a
+        // smaller or equal one proves nothing, and the file restores as before.
+        guard let stored = storedPeakShape, stored.count == 4, opened.shape.count == 4,
+              zip(stored, opened.shape).contains(where: { $0 > $1 }) else { return .adopt }
+        return .refuse(reason:
+            "The session file's stored disks cover a \(stored[1]) × \(stored[0]) scan on a "
+            + "\(stored[3]) × \(stored[2]) detector — larger than this file, \(opened.fileName) "
+            + "(\(opened.shapeSummary)) — so it belongs to another dataset and nothing was restored.")
+    }
+}
