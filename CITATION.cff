    title: >-
      py4DSTEM: A Software Package for Four-Dimensional Scanning Transmission
      Electron Microscopy Data Analysis
    authors:
      - family-names: Savitzky
        given-names: Benjamin H.
      - name: and the py4DSTEM developers
    journal: Microscopy and Microanalysis
