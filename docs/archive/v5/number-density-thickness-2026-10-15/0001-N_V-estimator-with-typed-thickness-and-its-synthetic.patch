+//
+//  PrecipitateNumberDensity.swift
+//  Role: volumetric number density N_V of precipitate plates from a class map and a TYPED foil thickness.
+//        Candidate of `docs/archive/v5/number-density-thickness-registration-2026-10-14.md` (design:
+//        `number-density-thickness-design-2026-10-15.md`). Per-object (Horvitz–Thompson) form, Nie & Muddle,
+//        Acta Mater. 56 (2008) 3490, as applied in arXiv:1804.09634 Eq. 2:
+//
+//            N_V = (1/A) Σᵢ wᵢ / (t + hᵢ),    hᵢ = s · Lᵢ,    Lᵢ = lengthPx · pixelSize
+//
+//        s = 1 for θ′ edge-on, √(2/3) for T1 on {111} (h = d·sin 54.74°); face-on θ′ has no h rule and refuses.
+//        wᵢ is `PrecipitateStatistics.edgeWeight` (Miles–Lantuéjoul on the bounding box with the forbidden border
+//        pixel excluded, i.e. S² / ((S − bx − p)(S − by − p))). Objects touching the scan edge are not counted.
+//        No truncation correction (centre outside the foil) and no overlap correction — registered as predicted
+//        failures. The thickness is TYPED; nothing here measures it. Ships badged `validation: "none"`.
+//
+//        σ terms, shown separately (independence assumed): with cᵢ = wᵢ/(t + hᵢ),
+//          σ_t,N = σ_t · (1/A) Σ cᵢ/(t + hᵢ)            (∂N/∂t)
+//          σ_P   = (1/A) √(Σ cᵢ²)                        (Poisson)
+//          σ_L   = σ_ℓ · p · (1/A) Σ s·cᵢ/(t + hᵢ)       (a common length shift of σ_ℓ = 1 px, ∂N/∂L; s = 1 for θ′)
+//
+
+import Foundation
+
+package nonisolated enum PrecipitateNumberDensity {
+    package nonisolated enum PlateClass: Sendable, Equatable { case thetaPrimeEdgeOn, t1On111, thetaPrimeFaceOn }
+    package nonisolated enum ThicknessSource: String, Sendable, Equatable { case eels = "EELS", cbed = "CBED", assumed = "assumed" }
+    package nonisolated struct Thickness: Sendable, Equatable {
+        package let nm: Double, sigmaNm: Double, source: ThicknessSource
+        package init(nm: Double, sigmaNm: Double, source: ThicknessSource) {
+            self.nm = nm; self.sigmaNm = sigmaNm; self.source = source
+        }
+    }
+    /// Never silently volumetric: each case is a reason the density is areal only.
+    package nonisolated enum Refusal: Error, Sendable, Equatable {
+        case noThickness, nonPositiveThickness, negativeThicknessSigma, noPixelSize, noPlateRule
+    }
+    package nonisolated struct ObjectTerm: Sendable, Equatable {
+        package let id: Int
+        package let lengthNm: Double
+        /// hᵢ, the extent along the beam.
+        package let extentAlongBeamNm: Double
+        package let edgeWeight: Double
+        /// cᵢ = wᵢ / (t + hᵢ), per nm² of scan area.
+        package let term: Double
+    }
+    package nonisolated struct Result: Sendable, Equatable {
+        package let countedObjects: Int
+        package let numberDensityPerNm3: Double
+        package let sigmaThicknessPerNm3: Double
+        package let sigmaPoissonPerNm3: Double
+        package let sigmaLengthPerNm3: Double
+        package let sigmaTotalPerNm3: Double
+        package let thickness: Thickness
+        /// "none": no independent thickness, no real-foil truth yet (CLAUDE.md, unvalidated stays labelled).
+        package let validation: String
+        package let perObject: [ObjectTerm]
+    }
+
+    /// σ_ℓ: the length systematic of a point-sampled mask, in pixels (design §1).
+    package nonisolated static let lengthSigmaPixels = 1.0
+
+    /// s = hᵢ / Lᵢ; nil where no rule exists (face-on θ′: areal only, unless a plate thickness is typed).
+    package nonisolated static func beamExtentFactor(_ plate: PlateClass) -> Double? {
+        switch plate {
+        case .thetaPrimeEdgeOn: return 1
+        case .t1On111: return (2.0 / 3.0).squareRoot()
+        case .thetaPrimeFaceOn: return nil
+        }
+    }
+
+    package nonisolated static func estimate(
+        objects: [PrecipitateSegmentation.Object], analysedPixels: Int, frameWidth: Int, frameHeight: Int,
+        pixelSizeNm: Double?, thickness: Thickness?, plate: PlateClass
+    ) throws -> Result {
+        guard let thickness else { throw Refusal.noThickness }
+        guard thickness.nm.isFinite, thickness.nm > 0 else { throw Refusal.nonPositiveThickness }
+        guard thickness.sigmaNm.isFinite, thickness.sigmaNm >= 0 else { throw Refusal.negativeThicknessSigma }
+        guard let p = pixelSizeNm, p.isFinite, p > 0, analysedPixels > 0 else { throw Refusal.noPixelSize }
+        guard let s = beamExtentFactor(plate) else { throw Refusal.noPlateRule }
+
+        let t = thickness.nm
+        var terms: [ObjectTerm] = []
+        var sum = 0.0, sumSquares = 0.0, sumSlope = 0.0
+        for o in objects where !o.touchesEdge {
+            let length = Double(o.lengthPx) * p
+            let h = s * length
+            let w = PrecipitateStatistics.edgeWeight(o, frameWidth: frameWidth, frameHeight: frameHeight)
+            let c = w / (t + h)
+            terms.append(ObjectTerm(id: o.id, lengthNm: length, extentAlongBeamNm: h, edgeWeight: w, term: c))
+            sum += c; sumSquares += c * c; sumSlope += c / (t + h)
+        }
+        let area = Double(analysedPixels) * p * p
+        let sigmaT = thickness.sigmaNm * sumSlope / area
+        let sigmaP = sumSquares.squareRoot() / area
+        let sigmaL = lengthSigmaPixels * p * s * sumSlope / area
+        return Result(
+            countedObjects: terms.count, numberDensityPerNm3: sum / area,
+            sigmaThicknessPerNm3: sigmaT, sigmaPoissonPerNm3: sigmaP, sigmaLengthPerNm3: sigmaL,
+            sigmaTotalPerNm3: (sigmaT * sigmaT + sigmaP * sigmaP + sigmaL * sigmaL).squareRoot(),
+            thickness: thickness, validation: "none", perObject: terms)
+    }
+}
