+/// Which source a session sidecar belongs to (Slot 4¾ review finding a2,
+/// 2026-10-02). Two sources in one folder — `scan.dm4` and py4DSTEM's
+/// `scan.h5` — share one sidecar path, so the file itself must say whose
+/// session it is. The NAME, never the path: a moved folder is the same
+/// session, and a screenshot-able attribute must not leak the filesystem
+/// (the `DataCubeDerivation` rule). The NATIVE shape — the file as stored,
+/// not the loaded view — so a cropped, binned or promoted reopen of the same
+/// file still matches. Stamped on the session root as JSON.
+package nonisolated struct SessionSourceIdentity: Codable, Sendable, Equatable {
+    package var fileName: String
+    /// `[ry, rx, qy, qx]` of the source at full extent.
+    package var shape: [Int]
+
+    package enum CodingKeys: String, CodingKey {
+        case fileName = "file_name"
+        case shape
+    }
+
+    package nonisolated init(fileName: String, shape: [Int]) {
+        self.fileName = fileName
+        self.shape = shape
+    }
+
+    /// The identity of `source`, which must be the FILE's descriptor
+    /// (`LoadView.source`), not a reduced view's.
+    package nonisolated init(source: DatasetDescriptor) {
+        self.init(fileName: source.fileName, shape: source.shape)
     }
+
+    /// "12 × 12 scan of 64 × 64 patterns" (width × height, the app's order).
+    package var shapeSummary: String {
+        guard shape.count == 4 else { return shape.map(String.init).joined(separator: " × ") }
+        return "\(shape[1]) × \(shape[0]) scan of \(shape[3]) × \(shape[2]) patterns"
+    }
+
+    /// Deterministic JSON, same conventions as the other stamped records.
+    package var jsonString: String? {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys]
+        // try? OK: a String and an [Int] cannot fail to encode; nil falls
+        // through to "write no attribute", which reads as an unstamped file.
+        guard let data = try? encoder.encode(self) else { return nil }
+        return String(data: data, encoding: .utf8)
+    }
+
+    /// Nil unless the JSON decodes to a non-empty name and four positive
+    /// extents — the reader refuses anything else by name.
+    package static func decoded(from json: String) -> SessionSourceIdentity? {
+        // try? OK: a decode failure IS the nil this function documents; the
+        // caller turns it into `malformedAttribute`, never into "absent".
+        guard let identity = try? JSONDecoder().decode(Self.self, from: Data(json.utf8)),
+              !identity.fileName.isEmpty, identity.shape.count == 4,
+              identity.shape.allSatisfy({ $0 > 0 }) else { return nil }
+        return identity
+    }
 }
 
