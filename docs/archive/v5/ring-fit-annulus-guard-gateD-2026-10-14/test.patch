+    /// A brighter ring just outside the annulus: R 70, eps 1 %, theta 20, no gap, noise 0.03, seed 1, a second ring
+    /// at 1.3 R (91 px) of amplitude 3 against the plant's 1, annulus [49.7, 90.3] px. Without the annulus guard the
+    /// profile fit follows the brighter ring out to a mean radius of 117 px, 67 % high, and is accepted (b / a off
+    /// by 0.004). The ring it fitted is not in the annulus the user drew, so the Fit refuses it and falls back to
+    /// the conic, saying why; the conic's own radius (86 px, the neighbour's skirt) is the conic's, not the guard's
+    /// (`archive/v5/ring-fit-annulus-guard-gateD-2026-10-14.md`; found by a scan of eight 192 px plants, R 60 and 70,
+    /// the neighbour at 1.2 R and 1.3 R, amplitude 1.5 and 3: only 1.3 R at R 70 puts the profile ring outside).
+    func testProfileRingOutsideItsAnnulusIsRefused() throws {
+        let plant = Plant(size: 192, radius: 70, eps: 0.01, thetaDegrees: 20, gap: 0, noise: 0.03, seed: 1,
+                          neighbour: 3, neighbourRadius: 1.3)
+        let fit = try EllipseCalibration.fitBestAvailable(
+            pattern: plant.render(),
+            centerQX: plant.centerQX + 1.3, centerQY: plant.centerQY - 0.9,
+            innerRadius: plant.b - 20, outerRadius: plant.a + 20)
+        XCTAssertEqual(fit.model, .conic, "a profile ring at mean radius \((fit.a + fit.b) / 2) outside [\(plant.b - 20), \(plant.a + 20)] was accepted")
+        XCTAssertTrue(fit.profileFallbackReason?.contains("left the annulus") ?? false,
+                      "fallback reason was \(fit.profileFallbackReason ?? "nil")")
+    }
+
+    /// The same plant with the neighbour at amplitude 1.5: the conic is over its 0.2 cap, so the Fit refuses.
+    func testProfileRingOutsideItsAnnulusIsRefusedWhenTheConicCannotStandIn() {
+        let plant = Plant(size: 192, radius: 70, eps: 0.01, thetaDegrees: 20, gap: 0, noise: 0.03, seed: 1,
+                          neighbour: 1.5, neighbourRadius: 1.3)
+        XCTAssertThrowsError(try EllipseCalibration.fitBestAvailable(
+            pattern: plant.render(),
+            centerQX: plant.centerQX + 1.3, centerQY: plant.centerQY - 0.9,
+            innerRadius: plant.b - 20, outerRadius: plant.a + 20)) { error in
+            XCTAssertTrue("\(error)".contains("ringOutsideAnnulus") || error.localizedDescription.contains("left the annulus"),
+                          "refused for another reason: \(error)")
+        }
+    }
