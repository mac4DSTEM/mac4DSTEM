# macOS and per-developer Xcode state
.DS_Store
**/.DS_Store
**/xcuserdata/
*.xcuserstate

# Xcode-generated SwiftPM workspace state. Regenerated on open; tracking it
# only produces churn between machines.
/.swiftpm/

# Machine-local scientific corpora and migration snapshots — and, since
# 2026-09-03, the py4DSTEM source lock too: tools/lib/fetch-py4dstem.sh clones
# it at one pinned upstream commit on demand. The inline `DEVIATION` notes in
# Core/ cite that commit's files by line; the pin is the reason they stay true.
/References

# Local build products
/build/
/DerivedData/

# tools/ui-qc-playthrough dev-scoping handoff (see run.sh)
/.ui-qc-filter
/.ui-qc-no-screenshots

# SwiftPM (Package.swift builds DSTEMCore from the shell)
.build/
.swiftpm/
