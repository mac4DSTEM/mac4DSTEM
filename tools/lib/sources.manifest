#!/bin/zsh
# tools/lib/sources.manifest — the ONE place a harness's app-source list is
# written. Created in v2 S2; since C2 (2026-09-07) every tools/harnesses/*/run.sh sources
# it or says in one line why it has nothing to take, and `run-tests.sh
# inventory` fails when one does neither.
#
# WHY THIS FILE EXISTS. On 2026-08-17 adding one file (Core/Data/ResidentCube.swift)
# silently broke 5 of 8 standalone harnesses, and the grep that went looking for
# them found 3 — because the same list is spelled three different ways across
# tools/harnesses/*/run.sh:
#
#     "$REPO/mac4DSTEM/Core/Data/FourDArray.swift"     # REPO=<repo root>
#     "$SRC/Data/FourDArray.swift"                     # SRC=<repo>/mac4DSTEM/Core
#     "$SRC/FourDArray.swift"                          # SRC=<repo>/mac4DSTEM/Core/Data
#
# `unit` and `scientific` both passed; the breakage only surfaced when the
# aggregate ran, because the affected runners live in `all` or outside the gate
# entirely. A list that cannot be grepped for is a list that cannot be
# maintained. See docs/open-items.md, "Second instance, 2026-08-17".
#
# USAGE — from a tools/<name>/run.sh (all of which are zsh):
#
#     . "$REPO/tools/lib/sources.manifest"
#     mac4dstem_sources "$REPO" analysis        # fills MAC4DSTEM_SOURCES
#     xcrun swiftc ... "${MAC4DSTEM_SOURCES[@]}" main.swift
#
# The result is delivered as the ARRAY `MAC4DSTEM_SOURCES`, not on stdout, so a
# checkout whose path contains a space cannot silently split into two
# nonexistent files. (zsh does field-split unquoted command substitution —
# verified 2026-08-19 — so `$(mac4dstem_sources ...)` would appear to work right
# up until someone clones into "~/My Projects".)
#
# STATUS, STATED PLAINLY: tools/harnesses/two-spec-analysis-test and
# tools/harnesses/strain-frame-test (v2 S8) source this file today. The hand-listing
# runners are exactly as exposed to the 2026-08-17 failure as they were before
# it existed. This file does not fix that breakage until they migrate
# (../_archive/mac4DSTEM/docs/archive/development-process-2026-08-31.md §1: when next touched), and saying otherwise
# would be a claim a reader cannot reproduce.
#
# GROUPS ARE DEPENDENCY-CLOSED. Asking for `analysis` gets the readers and the
# cube too, in compile order. That is the property that makes the file worth
# having: a new Core/Data file is added to ONE group here and every runner that
# needs it is fixed at once. Adding a file to a group it does not belong in
# costs a slower harness build; leaving it out costs a silent breakage, so when
# in doubt, include it.
#
# Groups intentionally stop at Core/. Nothing under App/ or UI/ belongs in a
# standalone harness — those need the app target, and the app build is the only
# gate for actor isolation (docs/open-items.md).

# Isolation flags matching the app target, for harnesses that want them.
#
# The app sets SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor and
# SWIFT_APPROACHABLE_CONCURRENCY = YES; bare `swiftc` defaults to *nonisolated*,
# so a harness compiled without these validates DIFFERENT isolation semantics
# from the app and cannot see an actor-isolation defect at all. Recorded as a
# blind spot on 2026-08-18 (docs/open-items.md); NARROWED, not closed, here.
#
# The five upcoming features are the full set `SWIFT_APPROACHABLE_CONCURRENCY =
# YES` turns on per Xcode's Swift.xcspec, plus MemberImportVisibility for the
# app's SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY. **The first version of
# this list carried three of the five** and still described itself as "matching
# the app target"; Gate B caught it on 2026-08-19. The two that were missing
# (DisableOutwardActorInference, InferIsolatedConformances) are inert on today's
# sources — the diagnostics are identical with and without them, measured — but
# a list that claims to match the app has to actually match it, or the next
# reader trusts a coverage that is not there.
#
# TWO LIMITS, BOTH MEASURED, NEITHER OF THEM SMALL:
#
# 1. THE WARNING DOES NOT GATE. `swiftc` exits 0 on an actor-isolation warning,
#    so `run.sh`'s `set -e` never fires and `scientific` stays green. These flags
#    make the defect VISIBLE in the build log; they do not make it fail. Turning
#    that into a gate means -warnings-as-errors, which today would fail the build
#    outright on the pre-existing FourDArray.swift:213 warning.
# 2. IT IS NOT A SUBSTITUTE FOR THE APP BUILD. `-parse-as-library` plus a `@main`
#    entry differs from an app target in ways these flags do not cover, and only
#    the app build compiles App/ and UI/. The app build remains the only real
#    gate for isolation.
#
# What it does buy, concretely: building tools/harnesses/two-spec-analysis-test with these
# flags surfaces one Swift 6 diagnostic that the same sources compiled bare do
# not produce at all (FourDArray.swift:213, ResidencyAdmission.shouldAdmit).
# Verified three ways on 2026-08-19 — bare: 0 warnings; these flags: 1; all five
# features: the same 1.
MAC4DSTEM_ISOLATION_FLAGS=(
  -swift-version 5
  -default-isolation MainActor
  -enable-upcoming-feature NonisolatedNonsendingByDefault
  -enable-upcoming-feature InferSendableFromCaptures
  -enable-upcoming-feature GlobalActorIsolatedTypesUsability
  -enable-upcoming-feature DisableOutwardActorInference
  -enable-upcoming-feature InferIsolatedConformances
  -enable-upcoming-feature MemberImportVisibility
)

# SpectroKit and FormatoKit (S4, 2026-10-13, ADR 064; 2026-10-15 SpectroKit 0.4.0 + FormatoKit 0.0.3). The standalone EDX
# core (SpectroCore, SpectroEDX) is SpectroKit's; the file readers (DM4Experiment, VeloxEMDReader) and the one HDF5 lock
# (HDF5Serial) are FormatoKit's (FormatoCore, FormatoDM, FormatoEMD, FormatoHDF5). mac4DSTEM imports them at the exact
# versions in Package.resolved. A harness cannot compile those sources into its own module: DM4Reader, H5Reader and
# BraggVectorEMDWriter `import` them. So `readers` and `export` link the libraries as modules: this builds the PINNED
# SpectroKit checkout (`swift package resolve` puts it in .build/checkouts) once in release, into .build/spectrokit-tools,
# with the targets SpectroCore and SpectroEDX; SwiftPM builds FormatoKit's four targets beside them from the tag
# SpectroKit's own manifest names, and that clone must be the FormatoKit revision pinned here (checked, exit 65 otherwise).
# SPECTROKIT_FLAGS (-I, the C module map, the seven prelinked objects) ride in MAC4DSTEM_SOURCES, which swiftc takes as
# inputs like any source. A wrong revision rebuilds; a failed build exits 65, loudly.
# SPECTROKIT_BUNDLE is the EDX tables' resource bundle (SpectroKit_SpectroEDX.bundle): a harness that reads
# QuantificationTables copies it beside its binary (Bundle.module looks there and traps otherwise).
# FORMATOKIT_BUNDLE is FormatoHDF5's (FormatoKit_FormatoHDF5.bundle, with its three libhdf5 dylibs); the reader harnesses
# keep MAC4DSTEM_HDF5_PATH on their own ad-hoc-signed copies of the repo's dylibs, which the lookup tries first.
spectrokit_module() {
  local repo=$1
  local ck="$repo/.build/checkouts/SpectroKit" fck="$repo/.build/checkouts/FormatoKit" scratch="$repo/.build/spectrokit-tools"
  local pin fpin
  pin=$(awk '/"identity" : "spectrokit"/ {f=1} f && /"revision"/ {gsub(/[",]/, "", $3); print $3; exit}' "$repo/Package.resolved")
  fpin=$(awk '/"identity" : "formatokit"/ {f=1} f && /"revision"/ {gsub(/[",]/, "", $3); print $3; exit}' "$repo/Package.resolved")
  if [[ -z "$pin" ]]; then echo "sources.manifest: no SpectroKit pin in $repo/Package.resolved" >&2; exit 65; fi
  if [[ -z "$fpin" ]]; then echo "sources.manifest: no FormatoKit pin in $repo/Package.resolved" >&2; exit 65; fi
  if [[ "$(git -C "$ck" rev-parse HEAD 2>/dev/null)" != "$pin" || "$(git -C "$fck" rev-parse HEAD 2>/dev/null)" != "$fpin" ]]; then
    (cd "$repo" && swift package resolve) >&2 || { echo "sources.manifest: swift package resolve failed" >&2; exit 65; }
  fi
  if [[ "$(git -C "$ck" rev-parse HEAD 2>/dev/null)" != "$pin" ]]; then
    echo "sources.manifest: $ck is not at the pinned SpectroKit $pin" >&2; exit 65
  fi
  if [[ "$(git -C "$fck" rev-parse HEAD 2>/dev/null)" != "$fpin" ]]; then
    echo "sources.manifest: $fck is not at the pinned FormatoKit $fpin" >&2; exit 65
  fi
  local prod="$scratch/out/Products/Release" t
  if [[ "$(cat "$scratch/.pin" 2>/dev/null)" != "$pin $fpin" || ! -f "$prod/SpectroEDX.o" || ! -f "$prod/FormatoHDF5.o" ]]; then
    for t in SpectroCore SpectroEDX; do
      swift build -c release --package-path "$ck" --scratch-path "$scratch" --target "$t" >&2 \
        || { echo "sources.manifest: building SpectroKit $pin ($t) failed" >&2; exit 65; }
    done
    # The Formato objects came from the clone SpectroKit's manifest fetched into the scratch: it must be the pinned one,
    # or the harness would test a FormatoKit the app does not ship (the exact pins agree today; this keeps it so).
    if [[ "$(git -C "$scratch/checkouts/FormatoKit" rev-parse HEAD 2>/dev/null)" != "$fpin" ]]; then
      echo "sources.manifest: SpectroKit $pin built FormatoKit $(git -C "$scratch/checkouts/FormatoKit" rev-parse HEAD 2>/dev/null), not the pinned $fpin" >&2
      exit 65
    fi
    echo "$pin $fpin" > "$scratch/.pin"
  fi
  SPECTROKIT_FLAGS=(-I "$prod"
    -Xcc "-fmodule-map-file=$scratch/out/Intermediates.noindex/GeneratedModuleMaps/CSpectroLAPACK.modulemap"
    "$prod/SpectroCore.o" "$prod/SpectroEDX.o" "$prod/CSpectroLAPACK.o"
    "$prod/FormatoCore.o" "$prod/FormatoDM.o" "$prod/FormatoEMD.o" "$prod/FormatoHDF5.o")
  SPECTROKIT_BUNDLE="$prod/SpectroKit_SpectroEDX.bundle"
  FORMATOKIT_BUNDLE="$prod/FormatoKit_FormatoHDF5.bundle"
}

# kit_module <repo-root> <Kit> <target>... (2026-10-15): DiffractoKit and CuboKit as SpectroKit above, for any kit
# without C targets or resources. Builds the pinned checkout's named targets (and what they depend on) once in
# release into .build/<kit>-tools; KIT_FLAGS (-I and the prelinked objects of every target built) ride in
# MAC4DSTEM_SOURCES. Exit 65 on a missing pin, a checkout off the pin, or a failed build.
kit_module() {
  local repo=$1 kit=$2; shift 2
  local id=${kit:l}
  local ck="$repo/.build/checkouts/$kit" scratch="$repo/.build/$id-tools"
  local pin
  pin=$(awk -v id="\"$id\"," '$0 ~ "\"identity\" : " id {f=1} f && /"revision"/ {gsub(/[",]/, "", $3); print $3; exit}' "$repo/Package.resolved")
  if [[ -z "$pin" ]]; then echo "sources.manifest: no $kit pin in $repo/Package.resolved" >&2; exit 65; fi
  if [[ "$(git -C "$ck" rev-parse HEAD 2>/dev/null)" != "$pin" ]]; then
    (cd "$repo" && swift package resolve) >&2 || { echo "sources.manifest: swift package resolve failed" >&2; exit 65; }
  fi
  if [[ "$(git -C "$ck" rev-parse HEAD 2>/dev/null)" != "$pin" ]]; then
    echo "sources.manifest: $ck is not at the pinned $kit $pin" >&2; exit 65
  fi
  local prod="$scratch/out/Products/Release" t
  if [[ "$(cat "$scratch/.pin" 2>/dev/null)" != "$pin $*" ]]; then
    for t in "$@"; do
      swift build -c release --package-path "$ck" --scratch-path "$scratch" --target "$t" >&2 \
        || { echo "sources.manifest: building $kit $pin ($t) failed" >&2; exit 65; }
    done
    echo "$pin $*" > "$scratch/.pin"
  fi
  KIT_FLAGS=("-I$prod" "$prod"/*.o(N))   # -I joined: mac4dstem_sources dedups its tokens
}

# mac4dstem_sources <repo-root> <group>...
#
# Fills MAC4DSTEM_SOURCES with absolute paths, deduplicated, in dependency
# order. Unknown group => exit 64, loudly: a typo'd group name that quietly
# contributed no sources would reproduce the very failure this file prevents.
mac4dstem_sources() {
  local repo=$1; shift
  local core="$repo/mac4DSTEM/Core"
  local -a want=()

  local group
  for group in "$@"; do
    case "$group" in
      data)
        want+=(
          "$core/Data/DatasetDescriptor.swift"
          "$core/Data/DiffractionPattern.swift"
          "$core/Data/FourDDataSource.swift"
          "$core/Data/LoadSpecification.swift"
          "$core/Data/RQRotationConvention.swift"
        )
        ;;
      calibration)
        # Calibration.swift's ellipse transform is DiffractoKit's EllipseTransform (2026-10-15): every harness that
        # composes this group links DiffractoGeometry (kit_module, above); KIT_FLAGS ride in MAC4DSTEM_SOURCES.
        kit_module "$repo" DiffractoKit DiffractoGeometry
        want+=("${KIT_FLAGS[@]}")
        mac4dstem_sources "$repo" data
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Data/Calibration.swift"
          "$core/Data/CalibrationReReference.swift"
        )
        ;;
      readers)
        # H5Reader adopts a file ellipse through Calibration.acceptedEllipse (review row 29).
        # The DM4 / Velox / HDF5-lock part is SpectroKit's (spectrokit_module, above).
        spectrokit_module "$repo"
        want+=("${SPECTROKIT_FLAGS[@]}")
        mac4dstem_sources "$repo" calibration
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Data/SessionSidecarFormat.swift"
          "$core/Data/H5Reader.swift"
          "$core/Data/DM4Reader.swift"
          "$core/Data/VendorRawReaders.swift"
          "$core/Data/DemoFourDDataSource.swift"
        )
        ;;
      cube)
        # CuboCubeSource is the app's cube seen by CuboKit (C1, 2026-10-15), and VirtualDetector reads it: the kit rides
        # in with the group, as SpectroKit rides in with `readers`.
        kit_module "$repo" CuboKit CuboVirtual CuboPhase
        want+=("${KIT_FLAGS[@]}")
        mac4dstem_sources "$repo" data
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Data/FourDArray.swift"
          "$core/Data/CuboCubeSource.swift"
          "$core/Data/ResidentCube.swift"
          "$core/Compute/AnalysisCancellationToken.swift"
          "$core/Compute/MetalEngine.swift"
        )
        ;;
      embedding)
        mac4dstem_sources "$repo" analysis
        want+=("${MAC4DSTEM_SOURCES[@]}")
        mac4dstem_sources "$repo" calibration
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Analysis/DiffractionEmbedding.swift"
        )
        ;;
      analysis)
        kit_module "$repo" ImagoKit ImagoCore   # FFT2D is ImagoKit's ImagoCore (2026-10-15)
        want+=("${KIT_FLAGS[@]}")
        mac4dstem_sources "$repo" cube
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Compute/MatrixDFTCorrelation.swift"
          "$core/Analysis/ProbeKernel.swift"
          "$core/Analysis/DiskDetection.swift"
          "$core/Analysis/TiledDiskDetection.swift"
          "$core/Analysis/VirtualDetector.swift"
        )
        ;;
      dpc)
        # DPC scalar/vector displays and iDPC integration. Kept separate from
        # `analysis` because that group owns the Metal-backed detector chain.
        # applyRotation is CuboKit's (C2, 2026-10-15).
        kit_module "$repo" ImagoKit ImagoCore   # FFT2D is ImagoKit's ImagoCore (2026-10-15)
        want+=("${KIT_FLAGS[@]}")
        kit_module "$repo" CuboKit CuboVirtual CuboPhase
        want+=("${KIT_FLAGS[@]}")
        mac4dstem_sources "$repo" calibration
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Analysis/DPC.swift"
        )
        ;;
      acom)
        # Production Bragg types and ACOM; no harness-side type replicas.
        # The crystal side is DiffractoKit's since 2026-10-15 (cells, CIF, structure factors, zone axes).
        kit_module "$repo" ImagoKit ImagoCore ImagoFFT   # FFT2D is ImagoKit's ImagoCore (2026-10-15); FFT1D is ImagoFFT's (0.1.1)
        want+=("${KIT_FLAGS[@]}")
        kit_module "$repo" DiffractoKit DiffractoGeometry
        want+=("${KIT_FLAGS[@]}")
        mac4dstem_sources "$repo" calibration
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Compute/AnalysisCancellationToken.swift"
          "$core/Compute/MetalEngine.swift"
          "$core/Compute/MatrixDFTCorrelation.swift"
          "$core/Analysis/ProbeKernel.swift"
          "$core/Analysis/DiskDetection.swift"
          "$core/Analysis/OrientationResult.swift"
          "$core/Crystal/Crystal.swift"
          "$core/Crystal/CrystalModel.swift"
          "$core/Crystal/OrientationPlan.swift"
          "$core/Crystal/OrientationMatcher.swift"
        )
        ;;
      qcalibration)
        # The Q-calibration chain (v2 S13): open a file, fit the origin, detect
        # disks, and estimate a reciprocal scale against a known crystal. It is
        # `readers` + `analysis` + the origin/Q estimators + the crystal side
        # that supplies the reference shell. OrientationPlan/OrientationMatcher
        # are deliberately absent — nothing here indexes.
        # The crystal side is DiffractoKit's since 2026-10-15 (cells, CIF, structure factors, zone axes).
        kit_module "$repo" ImagoKit ImagoCore ImagoFFT   # FFT1D is ImagoFFT's (0.1.1)
        want+=("${KIT_FLAGS[@]}")
        kit_module "$repo" DiffractoKit DiffractoGeometry
        want+=("${KIT_FLAGS[@]}")
        mac4dstem_sources "$repo" readers analysis calibration
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Analysis/OriginCalibration.swift"
          "$core/Analysis/FriedelOrigin.swift"
          "$core/Analysis/BeamstopMask.swift"
          "$core/Analysis/QCalibration.swift"
          "$core/Analysis/OrientationResult.swift"
          "$core/Crystal/Crystal.swift"
          "$core/Crystal/CrystalModel.swift"
        )
        ;;
      detection)
        # The CPU disk-detection chain (no Metal engine): the kernel, the
        # matrix-DFT correlation and the detector. Strain, export and the
        # parallax chain build on it. Added in C2 (2026-09-07) when the
        # remaining 46 harnesses adopted this file.
        kit_module "$repo" ImagoKit ImagoCore   # FFT2D is ImagoKit's ImagoCore (2026-10-15)
        want+=("${KIT_FLAGS[@]}")
        mac4dstem_sources "$repo" calibration
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Compute/AnalysisCancellationToken.swift"
          "$core/Compute/MatrixDFTCorrelation.swift"
          "$core/Analysis/ProbeKernel.swift"
          "$core/Analysis/DiskDetection.swift"
        )
        ;;
      replay)
        # A load specification and its calibration round-tripped through the
        # session replay record (tools/harnesses/load-spec-roundtrip).
        mac4dstem_sources "$repo" calibration
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Data/SessionLineage.swift"
          "$core/Data/SessionReplayRecord.swift"
        )
        ;;
      ellipse)
        # The fit itself is DiffractoKit's (linked by `calibration`, above); nothing else to compile.
        mac4dstem_sources "$repo" calibration
        want+=("${MAC4DSTEM_SOURCES[@]}")
        ;;
      rotation)
        # The R-Q rotation solve alone (tools/harnesses/rotation-parity-test): its
        # cancellation-token parameter and the FFT2D the surrogate null
        # links against, no `calibration` composition — RotationCalibration
        # takes no Calibration.swift type. Mirrors the ad hoc source list
        # ../_archive/mac4DSTEM/tools/rotation-null-probe/run.sh added by hand before this group
        # existed (checked 2026-09-17: RotationCalibration.swift was in
        # neither this file nor any group it composes). The objective is
        # CuboKit's RotationSolver (C2, 2026-10-15).
        kit_module "$repo" ImagoKit ImagoCore   # FFT2D is ImagoKit's ImagoCore (2026-10-15)
        want+=("${KIT_FLAGS[@]}")
        kit_module "$repo" CuboKit CuboVirtual CuboPhase
        want+=("${KIT_FLAGS[@]}")
        want+=(
          "$core/Compute/AnalysisCancellationToken.swift"
          "$core/Analysis/RotationCalibration.swift"
          "$core/Data/RQRotationConvention.swift"
        )
        ;;
      friedel)
        # The Friedel-symmetry origin finder and its beamstop-mask generator
        # (tools/harnesses/friedel-origin-test). FriedelOrigin needs FFT2D (which links
        # against AnalysisCancellationToken, same as the rotation group above);
        # BeamstopMask is pure array morphology, no extra dependency.
        kit_module "$repo" ImagoKit ImagoCore   # FFT2D is ImagoKit's ImagoCore (2026-10-15)
        want+=("${KIT_FLAGS[@]}")
        want+=(
          "$core/Compute/AnalysisCancellationToken.swift"
          "$core/Analysis/FriedelOrigin.swift"
          "$core/Analysis/BeamstopMask.swift"
        )
        ;;
      parallax)
        # The whole parallax chain; each parallax-*-test compiles all of it.
        kit_module "$repo" ImagoKit ImagoCore   # FFT2D is ImagoKit's ImagoCore (2026-10-15)
        want+=("${KIT_FLAGS[@]}")
        mac4dstem_sources "$repo" calibration
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Compute/AnalysisCancellationToken.swift"
          "$core/Compute/MatrixDFTCorrelation.swift"
          "$core/Analysis/ParallaxPreprocessing.swift"
          "$core/Analysis/ParallaxAlignment.swift"
          "$core/Analysis/ParallaxAberrationFitting.swift"
          "$core/Analysis/ParallaxAberrationCorrection.swift"
          "$core/Analysis/ParallaxSubpixelReconstruction.swift"
          "$core/Analysis/ParallaxDepthSectioning.swift"
        )
        ;;
      ptychography)
        # `calibration` (not `data`) and the preparer joined 2026-09-09 with
        # D002: PtychographyPreparation.swift had zero gated harness and zero
        # unit test (2026-08-31 review, tools-gates-05) while being the only
        # bridge from app data into the engine, and that is where the dropped
        # R-Q rotation lived. ParallaxPreprocessing carries
        # ParallaxPhysicalCalibration; DemoFourDDataSource is the cube the
        # position cases crop.
        kit_module "$repo" ImagoKit ImagoCore   # FFT2D is ImagoKit's ImagoCore (2026-10-15)
        want+=("${KIT_FLAGS[@]}")
        mac4dstem_sources "$repo" calibration
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Compute/AnalysisCancellationToken.swift"
          "$core/Compute/MatrixDFTCorrelation.swift"
          "$core/Data/DemoFourDDataSource.swift"
          "$core/Analysis/ParallaxPreprocessing.swift"
          "$core/Analysis/SingleslicePtychography.swift"
          "$core/Analysis/PtychographyPreparation.swift"
        )
        ;;
      presentation)
        # ResultPresentation on the calibration group: its sampling label reads CalibrationUnitConversion
        # (Calibration.swift, since 9925598) (tools/harnesses/result-presentation-test).
        mac4dstem_sources "$repo" calibration
        want+=("${MAC4DSTEM_SOURCES[@]}" "$core/Data/ResultPresentation.swift")
        ;;
      crystal)
        # Crystal models and CIF import, no indexing (cif-symmetry-test,
        # acom-orientation-test).
        # The crystal side is DiffractoKit's since 2026-10-15 (cells, CIF, structure factors, zone axes).
        kit_module "$repo" DiffractoKit DiffractoGeometry
        want+=("${KIT_FLAGS[@]}")
        mac4dstem_sources "$repo" data
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Analysis/OrientationResult.swift"
          "$core/Crystal/Crystal.swift"
          "$core/Crystal/CrystalModel.swift"
          "$core/Crystal/CIFModelImport.swift"
        )
        ;;
      phasevectors)
        # Vector-matched phase mapping: the reference library and the matcher are DiffractoKit's DiffractoOrientation
        # (0.3.0; the app's copies are deleted), linked on top of the ACOM stack they compose (phase-vector-matching).
        mac4dstem_sources "$repo" acom
        kit_module "$repo" DiffractoKit DiffractoGeometry DiffractoOrientation
        want+=("${KIT_FLAGS[@]}")
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Crystal/PhaseMappingScan.swift"
          "$core/Crystal/PhaseMapPresentation.swift"
        )
        ;;
      fitoverlays)
        # The fitted-overlay geometry over ACOM and strain (fit-overlay-test).
        mac4dstem_sources "$repo" acom strain
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Analysis/FitOverlays.swift"
        )
        ;;
      core)
        # Every Core/ source — what `swift build` compiles as DSTEMCore. For
        # the two diagnostics that touch most of it (bragg-spacing-probe,
        # training-dataset-campaign); a gated harness names its groups.
        # The crystal side is DiffractoKit's since 2026-10-15 (cells, CIF, structure factors, zone axes,
        # and Calibration.swift's ellipse transform); the cube, virtual detectors and rotation are CuboKit's (C1, C2).
        kit_module "$repo" DiffractoKit DiffractoGeometry
        want+=("${KIT_FLAGS[@]}")
        kit_module "$repo" CuboKit CuboVirtual CuboPhase
        want+=("${KIT_FLAGS[@]}")
        kit_module "$repo" ImagoKit ImagoCore   # FFT2D is ImagoKit's ImagoCore (2026-10-15)
        want+=("${KIT_FLAGS[@]}")
        want+=("$core"/**/*.swift(N))
        ;;
      strain)
        # The strain solver is CPU-only, on the detection chain, plus the
        # S8 presentation-frame rotation.
        kit_module "$repo" CuboKit CuboVirtual CuboPhase   # DPC.applyRotation (C2)
        want+=("${KIT_FLAGS[@]}")
        mac4dstem_sources "$repo" detection
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Analysis/DPC.swift"
          "$core/Analysis/QCalibration.swift"
          "$core/Analysis/StrainMapping.swift"
          "$core/Analysis/StrainFrame.swift"
        )
        ;;
      export)
        # The reduced-file export chain (v2 S10): the EMD writer, the recipe
        # it stamps, the native reader that verifies the file, and the frame
        # math the export composes with (CalibrationReReference, via the
        # `calibration` group). DiskDetection rides along because the writer's
        # BraggVectors type lives there (the `detection` group).
        spectrokit_module "$repo"
        want+=("${SPECTROKIT_FLAGS[@]}")
        mac4dstem_sources "$repo" detection replay
        want+=(
          "${MAC4DSTEM_SOURCES[@]}"
          "$core/Data/SessionSidecarFormat.swift"
          "$core/Data/H5Reader.swift"
          "$core/Data/BraggVectorEMDTypes.swift"
          "$core/Data/BraggVectorEMDWriter.swift"
          "$core/Data/HotPixelFilter.swift"
        )
        ;;
      *)
        echo "sources.manifest: unknown group '$group'" >&2
        echo "  known: data calibration readers cube analysis dpc acom qcalibration detection replay ellipse rotation friedel parallax ptychography presentation crystal fitoverlays core strain export embedding phasevectors" >&2
        exit 64
        ;;
    esac
  done

  # Deduplicate: swiftc rejects a repeated input file outright, so composing two
  # groups that share `data` would fail to build without this. First occurrence
  # is kept for readable output only — swiftc compiles a module as a unit and
  # does not care about source order. (An earlier comment here claimed the order
  # was load-bearing. It is not; Gate B, 2026-08-19.)
  # An ASSOCIATIVE array, not a membership test on a plain one: under `set -u`
  # (which every run.sh sets) `${seen[(r)$path]}` on a still-empty array is an
  # unset-parameter error, not an empty string.
  local -A seen=()
  local -a out=()
  local path
  for path in "${want[@]}"; do
    if (( ! ${+seen[$path]} )); then
      seen[$path]=1
      out+=("$path")
    fi
  done

  # Every path must exist. A renamed or deleted source silently dropping out of
  # a harness is exactly the 2026-08-17 failure running in the other direction.
  for path in "${out[@]}"; do
    # SPECTROKIT_FLAGS: the flags and the module directory are not sources.
    [[ "$path" == -* || -d "$path" ]] && continue
    if [[ ! -f "$path" ]]; then
      echo "sources.manifest: no such source '$path'" >&2
      echo "  A Core/ file was renamed or moved without updating this manifest." >&2
      exit 66
    fi
  done

  MAC4DSTEM_SOURCES=("${out[@]}")
}
