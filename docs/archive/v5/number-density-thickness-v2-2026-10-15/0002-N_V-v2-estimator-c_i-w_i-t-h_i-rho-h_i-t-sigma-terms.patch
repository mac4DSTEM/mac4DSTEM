+    /// Simpson intervals for the θ integral: 1000 resolves it to < 1e-9 for h/t ≤ 15; the integrand's knee near θ = π/2
+    /// has width ≈ t/h, so the count grows with h/t (≥ 50 intervals per knee width), capped at 200 000. Even.
+    package nonisolated static func intervals(h: Double, t: Double) -> Int {
+        let n = max(1000, Int((50 * h / t).rounded(.up)))
+        return min(n, 200_000) & ~1
+    }
+
+    /// I = ∫₀^{π/2} cos θ/D dθ, I_t = ∂I/∂t = −∫ cos θ/D², I_h = ∂I/∂h = −∫ cos² θ/D², D = t + h cos θ.
+    nonisolated private static func thetaIntegrals(h: Double, t: Double) -> (i: Double, it: Double, ih: Double) {
+        let n = intervals(h: h, t: t), dx = Double.pi / 2 / Double(n)
+        var i = 0.0, it = 0.0, ih = 0.0
+        for k in 0...n {
+            let c = cos(Double(k) * dx), d = t + h * c, w = (k == 0 || k == n) ? 1.0 : (k % 2 == 1 ? 4.0 : 2.0)
+            let inv = 1 / d
+            i += w * c * inv; it -= w * c * inv * inv; ih -= w * c * c * inv * inv
+        }
+        let f = dx / 3
+        return (i * f, it * f, ih * f)
+    }
+
+    /// ρ(h, t) = t/(t+h) + h ∫₀¹ dq/(t + h√(1−q²)) (q = sin θ); ρ(0, t) = 1 and ρ ≥ 1 increases with h.
+    package nonisolated static func truncationFactor(h: Double, t: Double) -> Double {
+        t / (t + h) + h * thetaIntegrals(h: h, t: t).i
+    }
+
+    /// cᵢ = w/g with g = (t+h)ρ = t + h(t+h)I, and its partials ∂c/∂t, ∂c/∂h (through ρ), plus ρ.
+    package nonisolated static func plugIn(weight w: Double, h: Double, t: Double)
+        -> (term: Double, rho: Double, dTermDt: Double, dTermDh: Double) {
+        let q = thetaIntegrals(h: h, t: t), u = t + h
+        let g = t + h * u * q.i
+        let gt = 1 + h * (q.i + u * q.it)
+        let gh = u * q.i + h * q.i + h * u * q.ih
+        return (w / g, g / u, -w * gt / (g * g), -w * gh / (g * g))
+    }
+
     package nonisolated static func estimate(
         objects: [PrecipitateSegmentation.Object], analysedPixels: Int, frameWidth: Int, frameHeight: Int,
         pixelSizeNm: Double?, thickness: Thickness?, plate: PlateClass
