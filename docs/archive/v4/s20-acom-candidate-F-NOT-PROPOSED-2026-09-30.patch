+    /// The correlation's azimuthal shift grid is this many times finer than the
+    /// polar image's `nAzimuthal` bins (the correlation spectrum is zero-padded
+    /// to `nAzimuthal * shiftOversampling` before the inverse transform).
+    ///
+    /// DEVIATION from py4DSTEM, and from this port's own earlier form. py4DSTEM
+    /// (and this port until now) deposit each spot at a rounded/linear azimuthal
+    /// bin and read the correlation only at whole-bin shifts. Off a bin
+    /// boundary the true template then pays a rounding mismatch that differs
+    /// between ring groups, and a wrong template that happens to sit on the
+    /// grid outscores it: 43 of 200 templates failed to recover themselves at a
+    /// 1.4 deg rotation (0 of 200 on-grid). Measured 2026-09-30
+    /// (docs/archive/v4/s20-acom-offgrid-results-2026-09-30.md): neither exact
+    /// azimuth alone (65 of 200 fail) nor a finer shift grid alone (26 of 200)
+    /// fixes it; both together do (0 of 200; 0 on-grid).
+    package static let shiftOversampling = 4
+
+    /// Azimuthal spectrum of every radial ring, ring-major `[nRadial, nAzimuthal]`
+    /// in FFT order, for a list of spots. Each spot is written at its EXACT
+    /// azimuth (no bin rounding): the circular Gaussian blur of `azimBlurBins`
+    /// is applied as its frequency response, the radial spreading is the one
+    /// `buildPolar` uses, each ring's mean (frequency 0) is removed, and the
+    /// whole image is normalised so its L2 norm is 1 (sum |X|^2 = nAzimuthal by
+    /// Parseval). Fed rounded azimuths and an unpadded inverse it reproduces
+    /// `buildPolar` + `normalizeUnit` + `ringFFTs` to ~1e-5.
+    package static func azimuthalSpectra(
+        spots: [(r: Double, azim: Double, weight: Double)],
+        geometry geo: PolarGeometry, azimBlurBins: Double,
+        radialKernelInvAngstrom: Double
+    ) -> (re: [Float], im: [Float]) {
+        let nr = geo.nRadial, na = geo.nAzimuthal
+        var re = [Double](repeating: 0, count: nr * na)
+        var im = [Double](repeating: 0, count: nr * na)
+        // Frequency response of the shipped discrete Gaussian blur.
+        var response = [Double](repeating: 1, count: na)
+        if azimBlurBins > 0 {
+            let radius = max(1, Int((3 * azimBlurBins).rounded()))
+            var taps = [Double](repeating: 0, count: 2 * radius + 1)
+            var sum = 0.0
+            for i in -radius...radius {
+                let v = Double(exp(-Float(i * i) / Float(2 * azimBlurBins * azimBlurBins)))
+                taps[i + radius] = v; sum += v
+            }
+            for k in 0..<na {
+                let signed = k < na / 2 ? k : k - na
+                var acc = 0.0
+                for t in -radius...radius {
+                    acc += taps[t + radius] / sum * cos(2 * Double.pi * Double(signed * t) / Double(na))
+                }
+                response[k] = acc
+            }
+        }
+        let sigmaBins = radialKernelInvAngstrom / geo.radialScale
+        let reach = sigmaBins > 0 ? max(1, Int((3 * sigmaBins).rounded())) : 0
+        let twoPi = 2 * Double.pi
+        var cosine = [Double](repeating: 0, count: na)
+        var sine = [Double](repeating: 0, count: na)
+        for s in spots {
+            let exact = s.r / geo.radialScale
+            let rb = Int(exact.rounded())
+            if rb + reach < 0 || rb - reach >= nr { continue }
+            var a = s.azim.truncatingRemainder(dividingBy: twoPi)
+            if a < 0 { a += twoPi }
+            for k in 0..<na {
+                let signed = Double(k < na / 2 ? k : k - na)
+                cosine[k] = cos(signed * a); sine[k] = -sin(signed * a)
+            }
+            for bin in (rb - reach)...(rb + reach) where bin >= 0 && bin < nr {
+                var w = s.weight
+                if reach > 0 {
+                    let d = (Double(bin) - exact) / sigmaBins
+                    w *= Double(Float(exp(-0.5 * d * d)))
+                }
+                for k in 1..<na {
+                    let g = w * response[k]
+                    re[bin * na + k] += g * cosine[k]
+                    im[bin * na + k] += g * sine[k]
+                }
+            }
+        }
+        var norm2 = 0.0
+        for i in 0..<(nr * na) { norm2 += re[i] * re[i] + im[i] * im[i] }
+        let scale = norm2 > 0 ? (Double(na) / norm2).squareRoot() : 0
+        return (re.map { Float($0 * scale) }, im.map { Float($0 * scale) })
+    }
