+//
+//  ReviewSidecarIdentityWiringTests.swift
+//  Lane B (Slot 4¾ review a2, 2026-10-02): the app's own sidecar saves stamp the source — the half of the identity
+//  check that lives in ResultExport.swift (resultexport-stamp.patch) and AppState.recordedLoadSpecification
+//  (appstate-recorded-spec.patch). Lands WITH both patches, never without them.
+//
+
+import XCTest
+import DSTEMCore
+import DSTEMSession
+@testable import mac4DSTEM
+
+@MainActor
+final class ReviewSidecarIdentityWiringTests: XCTestCase {
+
+    private func isolatedAppState() throws -> AppState {
+        let suite = "mac4dstem.tests.\(UUID().uuidString)"
+        let defaults = try XCTUnwrap(UserDefaults(suiteName: suite))
+        addTeardownBlock { UserDefaults().removePersistentDomain(forName: suite) }
+        return AppState(sessionSidecar: SessionSidecarLocator(defaults: defaults))
+    }
+
+    /// A calibration save from a BINNED view stamps the FILE's name and native shape, not the view's.
+    /// Mutation: drop `sourceIdentity:` from the mergeCalibration call in ResultExport -> red (no stamp).
+    func testACalibrationSaveFromABinnedViewStampsTheFilesNativeIdentity() async throws {
+        let state = try isolatedAppState()
+        await state.openDemoFixture(calibrated: true, specification: LoadSpecification(detectorBin: 2))
+        let descriptor = try XCTUnwrap(state.descriptor)
+        XCTAssertEqual(descriptor.qx, 32, "precondition: the view is binned")
+        let directory = FileManager.default.temporaryDirectory
+            .appendingPathComponent("lane-b-wiring-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        addTeardownBlock { try? FileManager.default.removeItem(at: directory) }
+        let sidecar = directory.appendingPathComponent("demo.mac4dstem.h5")
+        state.sessionSidecar.adopt(sidecar, for: descriptor)
+
+        state.saveCalibrationToSessionSidecar()
+        let deadline = Date().addingTimeInterval(10)
+        while !state.statusText.contains("Saved calibration"), Date() < deadline {
+            try await Task.sleep(nanoseconds: 20_000_000)
+        }
+        XCTAssertTrue(state.statusText.contains("Saved calibration"), state.statusText)
+        XCTAssertEqual(try BraggVectorEMDWriter.loadSession(from: sidecar).sourceIdentity,
+                       SessionSourceIdentity(source: DemoFourDDataSource.descriptor))
+    }
+
+    /// A sibling's stamped sidecar that records a CROP must not crop this file on open; this file's own does.
+    /// Mutation: drop the source check in `recordedLoadSpecification` -> red (the sibling's crop comes back).
+    func testASiblingsRecordedCropIsNotAppliedToThisFile() async throws {
+        let source = DemoFourDDataSource.descriptor
+        let crop = LoadSpecification(scanCrop: AxisCrop(yOffset: 0, xOffset: 0, height: 6, width: 6))
+        let directory = FileManager.default.temporaryDirectory
+            .appendingPathComponent("lane-b-crop-\(UUID().uuidString)")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        addTeardownBlock { try? FileManager.default.removeItem(at: directory) }
+        for (identity, expected) in [
+            (SessionSourceIdentity(fileName: "mac4DSTEM Demo.dm4", shape: [12, 12, 128, 128]), nil as LoadSpecification?),
+            (SessionSourceIdentity(source: source), crop),
+        ] {
+            let sidecar = directory.appendingPathComponent("\(UUID().uuidString).mac4dstem.h5")
+            try BraggVectorEMDWriter.mergeCalibration(PixelCalibration(qSize: 0.0123), qWidth: identity.shape[3],
+                                                      qHeight: identity.shape[2], to: sidecar,
+                                                      loadSpecification: crop, sourceIdentity: identity)
+            let state = try isolatedAppState()
+            state.sessionSidecar.adopt(sidecar, forSourcePath: source.filePath)
+            let recorded = await state.recordedLoadSpecification(forSourcePath: source.filePath, source: source)
+            XCTAssertEqual(recorded, expected, identity.fileName)
+            XCTAssertEqual(state.gates.sidecarRestoreFailure?.kind, expected == nil ? .doesNotFit : nil, identity.fileName)
+        }
+    }
+}
