+#!/bin/zsh
+# diagnostic: N_V synthetic foil of docs/archive/v5/number-density-thickness-registration-2026-10-14.md
+#
+# Plates of known N_V in a foil, point-sampled onto a scan grid, counted through the app's own
+# PrecipitateSegmentation.classObjects and scored through the candidate PrecipitateNumberDensity.estimate.
+# Every parameter is fixed by number-density-thickness-design-2026-10-15.md §3. `diagnostic`: a measurement about an
+# estimator, not a gated invariant of the code; it runs for minutes (54 cells, T6_JOBS parallel, default 6).
+set -euo pipefail
+
+cd "$(dirname "$0")"
+REPO="$(cd ../.. && pwd)"
+WORK="$(mktemp -d "${TMPDIR:-/tmp}/mac4dstem-number-density-test.XXXXXX")"
+trap 'rm -rf "$WORK"' EXIT
+. "$REPO/tools/lib/developer-dir.sh"
+resolve_mac4dstem_developer_dir
+
+# Foundation only: the three precipitate files plus FloatImage's file (as tools/volumetric-density-test).
+xcrun swiftc -O -package-name mac4DSTEM -parse-as-library -swift-version 5 \
+  -o "$WORK/nv" \
+  main.swift \
