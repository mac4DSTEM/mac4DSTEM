+    // MARK: rho and the plug-in, independent of the production quadrature
+
+    /// J(t, h) = int_0^{pi/2} dtheta / (t + h cos theta), closed form (three branches).
+    private func jClosed(_ t: Double, _ h: Double) -> Double {
+        if abs(t - h) < 1e-12 * t { return 1 / t }
+        if t > h { return 2 / (t * t - h * h).squareRoot() * atan(((t - h) / (t + h)).squareRoot()) }
+        let a = (h + t).squareRoot(), b = (h - t).squareRoot()
+        return log((a + b) / (a - b)) / (h * h - t * t).squareRoot()
+    }
+    /// rho(h, t) = t/(t+h) + h int_0^1 dq / (t + h sqrt(1-q^2)) = t/(t+h) + pi/2 - t J (q = sin theta).
+    private func rhoClosed(h: Double, t: Double) -> Double { t / (t + h) + Double.pi / 2 - t * jClosed(t, h) }
+    /// c = w / ((t + h) rho)
+    private func cClosed(w: Double, h: Double, t: Double) -> Double { w / ((t + h) * rhoClosed(h: h, t: t)) }
+    /// The registration's literal q-integral by a fine midpoint rule (2e6 points; sqrt end point -> error ~ N^-1.5).
+    private func rhoMidpointInQ(h: Double, t: Double) -> Double {
+        let n = 2_000_000
+        var acc = 0.0
+        for i in 0..<n { let q = (Double(i) + 0.5) / Double(n); acc += 1 / (t + h * (1 - q * q).squareRoot()) }
+        return t / (t + h) + h * acc / Double(n)
+    }
+    /// The same integral by a fine trapezoid in theta (q = sin theta, smooth integrand), 400000 intervals.
+    private func rhoTrapezoidInTheta(h: Double, t: Double) -> Double {
+        let n = 400_000, dx = Double.pi / 2 / Double(n)
+        func f(_ th: Double) -> Double { cos(th) / (t + h * cos(th)) }
+        var acc = 0.5 * (f(0) + f(Double.pi / 2))
+        for i in 1..<n { acc += f(Double(i) * dx) }
+        return t / (t + h) + h * acc * dx
+    }
+
