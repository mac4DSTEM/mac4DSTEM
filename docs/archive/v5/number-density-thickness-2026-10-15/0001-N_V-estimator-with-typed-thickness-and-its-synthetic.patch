+//
+
+import XCTest
+import DSTEMCore
+import DSTEMSession
+@testable import mac4DSTEM
+
+final class PrecipitateNumberDensityTests: XCTestCase {
+    typealias ND = PrecipitateNumberDensity
+    typealias Seg = PrecipitateSegmentation
+
+    private let frame = 100
+    private let p = 2.0   // nm per pixel
+
+    /// A horizontal 1-px line of n pixels at (row, col0..), as an Object with an exact lengthPx.
+    private func line(id: Int, row: Int, col0: Int, n: Int, length: Float? = nil, edge: Bool = false, width: Int = 100) -> Seg.Object {
+        Seg.Object(id: id, pixelIndices: (0..<n).map { row * width + col0 + $0 }, area: n,
+                   centroidX: Float(col0) + Float(n - 1) / 2, centroidY: Float(row),
+                   lengthPx: length ?? Float(n), widthPx: 1, orientationDegrees: 0,
+                   touchesEdge: edge, meanIntensity: 1)
+    }
+    private func three(_ dl: Float = 0) -> [Seg.Object] {
+        [line(id: 1, row: 20, col0: 10, n: 10, length: 10 + dl), line(id: 2, row: 40, col0: 10, n: 20, length: 20 + dl),
+         line(id: 3, row: 60, col0: 10, n: 30, length: 30 + dl)]
+    }
+    private func run(_ objs: [Seg.Object], t: Double = 100, sigmaT: Double = 10, plate: ND.PlateClass = .thetaPrimeEdgeOn,
+                     pixel: Double? = 2.0, thickness: ND.Thickness? = nil, w: Int = 100, h: Int = 100) throws -> ND.Result {
+        try ND.estimate(objects: objs, analysedPixels: w * h, frameWidth: w, frameHeight: h, pixelSizeNm: pixel,
+                        thickness: thickness ?? ND.Thickness(nm: t, sigmaNm: sigmaT, source: .assumed), plate: plate)
+    }
+    /// Hand values for `three()` at p = 2 nm, 100 x 100 px: w = 10000 / ((99 - n) * 98), L = 2n nm.
+    private var w1: Double { 10000.0 / (89 * 98) }
+    private var w2: Double { 10000.0 / (79 * 98) }
+    private var w3: Double { 10000.0 / (69 * 98) }
+    private let area = 10000.0 * 4.0   // nm^2
+
+    // Mutation: h = L for T1 (drop sqrt(2/3)), or swap the class factors.
+    func testExtentAlongBeamPerClass() {
+        XCTAssertEqual(ND.beamExtentFactor(.thetaPrimeEdgeOn), 1.0)
+        XCTAssertEqual(ND.beamExtentFactor(.t1On111)!, (2.0 / 3.0).squareRoot(), accuracy: 1e-15)
+        XCTAssertNil(ND.beamExtentFactor(.thetaPrimeFaceOn), "face-on theta' has no h rule: areal only")
+    }
+
+    // Mutation: drop any refusal branch (t <= 0, sigma < 0, nil, NaN, no pixel size, face-on).
+    func testRefusals() {
+        let objs = three()
+        func refusal(_ f: () throws -> ND.Result) -> ND.Refusal? {
+            do { _ = try f(); return nil } catch let r as ND.Refusal { return r } catch { return nil }
+        }
+        XCTAssertEqual(refusal { try ND.estimate(objects: objs, analysedPixels: 10000, frameWidth: 100, frameHeight: 100,
+                                                 pixelSizeNm: 2, thickness: nil, plate: .thetaPrimeEdgeOn) }, .noThickness)
+        XCTAssertEqual(refusal { try self.run(objs, t: 0) }, .nonPositiveThickness)
+        XCTAssertEqual(refusal { try self.run(objs, t: -5) }, .nonPositiveThickness)
+        XCTAssertEqual(refusal { try self.run(objs, t: .nan) }, .nonPositiveThickness)
+        XCTAssertEqual(refusal { try self.run(objs, t: .infinity) }, .nonPositiveThickness)
+        XCTAssertEqual(refusal { try self.run(objs, sigmaT: -1) }, .negativeThicknessSigma)
+        XCTAssertEqual(refusal { try self.run(objs, sigmaT: .nan) }, .negativeThicknessSigma)
+        XCTAssertEqual(refusal { try self.run(objs, pixel: nil) }, .noPixelSize)
+        XCTAssertEqual(refusal { try self.run(objs, pixel: 0) }, .noPixelSize)
+        XCTAssertEqual(refusal { try self.run(objs, plate: .thetaPrimeFaceOn) }, .noPlateRule)
+        XCTAssertNil(refusal { try self.run(objs, sigmaT: 0) }, "sigma_t = 0 is allowed")
+    }
+
+    // Mutation: use N/(A t), drop the edge weight, use L instead of t + h, or count edge objects.
+    func testValueMatchesHandDerivedThreeObjectCase() throws {
+        let r = try run(three() + [line(id: 4, row: 80, col0: 0, n: 10, edge: true)])
+        XCTAssertEqual(r.countedObjects, 3, "an object touching the scan edge is not counted")
+        let expected = (w1 / (100 + 20) + w2 / (100 + 40) + w3 / (100 + 60)) / area
+        XCTAssertEqual(r.numberDensityPerNm3, expected, accuracy: expected * 1e-12)
+        XCTAssertEqual(r.perObject.map(\.extentAlongBeamNm), [20, 40, 60])
+        XCTAssertEqual(r.perObject[0].edgeWeight, w1, accuracy: 1e-12)
+    }
+
+    // Mutation: T1 uses s = 1.
+    func testT1UsesSqrtTwoThirds() throws {
+        let s = (2.0 / 3.0).squareRoot()
+        let r = try run(three(), plate: .t1On111)
+        let expected = (w1 / (100 + 20 * s) + w2 / (100 + 40 * s) + w3 / (100 + 60 * s)) / area
+        XCTAssertEqual(r.numberDensityPerNm3, expected, accuracy: expected * 1e-12)
+    }
+
+    // Mutation: wrong sigma formula (drop 1/(t+h), use sigma_t alone, sum in quadrature instead of linearly).
+    func testSigmaTermsHandDerived() throws {
+        let c = [w1 / 120, w2 / 140, w3 / 160]
+        let h = [120.0, 140, 160]
+        let r = try run(three(), sigmaT: 10)
+        let sT = 10 * (c[0] / h[0] + c[1] / h[1] + c[2] / h[2]) / area
+        let sP = (c[0] * c[0] + c[1] * c[1] + c[2] * c[2]).squareRoot() / area
+        let sL = 1.0 * 2.0 * (c[0] / h[0] + c[1] / h[1] + c[2] / h[2]) / area   // sigma_l = 1 px = 2 nm, s = 1
+        XCTAssertEqual(r.sigmaThicknessPerNm3, sT, accuracy: sT * 1e-12)
+        XCTAssertEqual(r.sigmaPoissonPerNm3, sP, accuracy: sP * 1e-12)
+        XCTAssertEqual(r.sigmaLengthPerNm3, sL, accuracy: sL * 1e-12)
+        XCTAssertEqual(r.sigmaTotalPerNm3, (sT * sT + sP * sP + sL * sL).squareRoot(), accuracy: 1e-12 * r.sigmaTotalPerNm3)
+    }
+
+    // P5: sigma_t,N equals |d N_V / d t| * sigma_t from a central finite difference, to 1e-6 relative.
+    func testSigmaThicknessEqualsFiniteDifference() throws {
+        let d = 0.01
+        let up = try run(three(), t: 100 + d).numberDensityPerNm3, dn = try run(three(), t: 100 - d).numberDensityPerNm3
+        let slope = (up - dn) / (2 * d)
+        XCTAssertLessThan(slope, 0)
+        let r = try run(three(), t: 100, sigmaT: 7)
+        XCTAssertEqual(r.sigmaThicknessPerNm3, abs(slope) * 7, accuracy: abs(slope) * 7 * 1e-6)
+    }
+
+    // The length term is the derivative with respect to a common length shift (sigma_l = 1 px), T1 included.
+    func testSigmaLengthEqualsFiniteDifferenceOfCommonShift() throws {
+        let eps: Float = 0.01
+        for plate in [ND.PlateClass.thetaPrimeEdgeOn, .t1On111] {
+            let up = try run(three(eps), plate: plate).numberDensityPerNm3, dn = try run(three(-eps), plate: plate).numberDensityPerNm3
+            let slopePerPx = abs(up - dn) / Double(2 * eps)
+            let r = try run(three(), plate: plate)
+            XCTAssertEqual(r.sigmaLengthPerNm3, slopePerPx * 1.0, accuracy: slopePerPx * 2e-3)
+        }
+    }
+
+    // Provenance: validation "none", t, sigma_t, source, h_i per object.
+    func testProvenanceCarriesThicknessAndValidationNone() throws {
+        let r = try run(three(), thickness: ND.Thickness(nm: 80, sigmaNm: 5, source: .cbed))
+        XCTAssertEqual(r.validation, "none")
+        XCTAssertEqual(r.thickness, ND.Thickness(nm: 80, sigmaNm: 5, source: .cbed))
+        XCTAssertEqual(r.perObject.count, 3)
+    }
+
+    // Fixture: a synthetic foil, 36 identical edge-on plates (L = 100 nm) in t = 50 nm. Truth by construction:
+    // every plate is a whole plate of extent 100 along the beam, so one plate stands for 1 / (A (t + L)). The naive
+    // N / (A t) reads 3x truth here and must not be what the code returns.
+    func testSyntheticFoilIsRedOnTheNaiveForm() throws {
+        let side = 500, pp = 2.0
+        var objs: [Seg.Object] = []
+        for j in 0..<6 { for i in 0..<6 {
+            objs.append(line(id: j * 6 + i, row: 10 + 80 * j, col0: 10 + 80 * i, n: 50, edge: false, width: side))
+        } }
+        let r = try ND.estimate(objects: objs, analysedPixels: side * side, frameWidth: side, frameHeight: side,
+                                pixelSizeNm: pp, thickness: .init(nm: 50, sigmaNm: 0, source: .assumed), plate: .thetaPrimeEdgeOn)
+        let a = Double(side * side) * pp * pp
+        let nomW = Double(side * side) / (Double((side - 50 - 1) * (side - 2)))   // same weight for every plate
+        let truthLike = 36 * nomW / (a * 150)
+        XCTAssertEqual(r.numberDensityPerNm3, truthLike, accuracy: truthLike * 1e-12)
+        let naive = 36 / (a * 50)
+        XCTAssertGreaterThan(naive / r.numberDensityPerNm3, 2.5, "the naive form overshoots 3x: this fixture can fail it")
+    }
+}
diff --git a/tools/number-density-test/main.swift b/tools/number-density-test/main.swift
new file mode 100644
index 00000000..e2be4be7
--- /dev/null
+++ b/tools/number-density-test/main.swift
@@ -0,0 +1,322 @@
+//
+//  N_V — precipitate number density with typed thickness: synthetic truth harness.
+//  Registration docs/archive/v5/number-density-thickness-registration-2026-10-14.md; every parameter below is fixed by
+//  docs/archive/v5/number-density-thickness-design-2026-10-15.md §3 (committed before any run).
+//
+//  Model: field S = 2400 nm square, pixel p (2.5 nm default; T6_PIXEL_NM=1.25), foil 0 <= z <= t. Plates are discs of
+//  diameter d (R = d/2), beam along z. theta' edge-on: normal uniform in {+-x, +-y}, s = 1. T1: normal uniform in
+//  {(+-1, +-1, 1)/sqrt3}, s = sqrt(2/3); h = s d is the extent along z.
+//  RASTER = POINT SAMPLING (design §1): pixel (i, j) is on iff its centre lies in the projection of the plate's in-foil
+//  part. DEVIATION from design §3 wording ("zero-thickness"): a zero-thickness edge-on plate has measure zero under point
+//  sampling, so each plate carries a physical thickness tau = p (a slab of normal thickness p, the in-foil part of
+//  which is projected). The chord LENGTH is exact; only the width is p. Truth is unaffected (h = s d).
+//  Sizes: d = dbar (CV 0) or lognormal(sigma^2 = ln(1+CV^2), mean dbar) truncated at 4 dbar, drawn size-biased by
+//  V(d) = (S+2R)^2 (t + h) so the volumetric density of size d is proportional to f(d). Centres uniform in
+//  x, y in [-R, S+R], z in [-h/2, t+h/2] of each plate's own R, h. Overlap rejection on a canvas covering the whole
+//  generation box (8-neighbour, one-pixel dilation). Stop at 1 % in-field occupied pixels.
+//  Truth N_V = sum over accepted plates of 1/V(d_k). Counting: PrecipitateSegmentation.classObjects, objects with
+//  touchesEdge == false, through the CANDIDATE PrecipitateNumberDensity.estimate (sigma_t = 0).
+//  Seeds: state = cellIndex*0x100000001B3 + seedIndex*0xD6E8FEB86659FD93 + 0x12345678, two draws discarded;
+//  >= 100 seeds until SEM(ratio) <= 0.015, cap 400.
+
+import Foundation
+
+let env = ProcessInfo.processInfo.environment
+let fieldNm = 2400.0
+let pixelNm = Double(env["T6_PIXEL_NM"] ?? "") ?? 2.5
+let W = Int((fieldNm / pixelNm).rounded()), H = W
+let coverageTarget = 0.01
+let minSeeds: Int = Int(env["T6_MIN_SEEDS"] ?? "") ?? 100
+let maxSeeds: Int = Int(env["T6_MAX_SEEDS"] ?? "") ?? 400
+let semTarget = 0.015
+let passBar = 0.05
+let capFactor = 4.0
+let jobs = Int(env["T6_JOBS"] ?? "") ?? 6
+
+enum PlateClass: String { case thetaPrime = "theta'", t1 = "T1" }
+struct Cell { let cls: PlateClass; let dbar: Double; let t: Double; let cv: Double; let index: Int }
+
+struct SplitMix64 {
+    var state: UInt64
+    mutating func next() -> UInt64 {
+        state &+= 0x9E3779B97F4A7C15
+        var z = state
+        z = (z ^ (z >> 30)) &* 0xBF58476D1CE4E5B9
+        z = (z ^ (z >> 27)) &* 0x94D049BB133111EB
+        return z ^ (z >> 31)
+    }
+    mutating func uniform() -> Double { Double(next() >> 11) * (1.0 / 9007199254740992.0) }
+    mutating func gaussian() -> Double {
+        let u1 = max(uniform(), 1e-300), u2 = uniform()
+        return (-2 * log(u1)).squareRoot() * cos(2 * Double.pi * u2)
+    }
+}
+
+func sFactor(_ c: PlateClass) -> Double { c == .thetaPrime ? 1.0 : (2.0 / 3.0).squareRoot() }
+
+// MARK: - Analytic prediction (design §2), a quadrature of rho over the truncated lognormal
+
+func rho(h: Double, t: Double) -> Double {
+    let n = 400
+    var acc = 0.0
+    for i in 0..<n { let q = (Double(i) + 0.5) / Double(n); acc += 1 / (t + h * (1 - q * q).squareRoot()) }
+    return t / (t + h) + h * acc / Double(n)
+}
+func inverseNormalCDF(_ p: Double) -> Double {   // Acklam
+    let a = [-3.969683028665376e+01, 2.209460984245205e+02, -2.759285104469687e+02, 1.383577518672690e+02, -3.066479806614716e+01, 2.506628277459239e+00]
+    let b = [-5.447609879822406e+01, 1.615858368580409e+02, -1.556989798598866e+02, 6.680131188771972e+01, -1.328068155288572e+01]
+    let c = [-7.784894002430293e-03, -3.223964580411365e-01, -2.400758277161838e+00, -2.549732539343734e+00, 4.374664141464968e+00, 2.938163982698783e+00]
+    let d = [7.784695709041462e-03, 3.224671290700398e-01, 2.445134137142996e+00, 3.754408661907416e+00]
+    if p < 0.02425 {
+        let q = (-2 * log(p)).squareRoot()
+        return (((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) / ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)
+    } else if p > 1 - 0.02425 {
+        let q = (-2 * log(1 - p)).squareRoot()
+        return -(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) / ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)
+    }
+    let q = p - 0.5, r = q * q
+    return (((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q / (((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1)
+}
+func predicted(_ cell: Cell) -> Double {
+    let s = sFactor(cell.cls)
+    if cell.cv == 0 { return rho(h: s * cell.dbar, t: cell.t) }
+    let sg = log(1 + cell.cv * cell.cv).squareRoot(), mu = log(cell.dbar) - sg * sg / 2
+    var sum = 0.0, n = 0
+    for i in 0..<400 {
+        let d = exp(mu + sg * inverseNormalCDF((Double(i) + 0.5) / 400))
+        if d <= capFactor * cell.dbar { sum += rho(h: s * d, t: cell.t); n += 1 }
+    }
+    return sum / Double(n)
+}
+
+// MARK: - Point-sampled footprint of one plate
+
+/// Pixels (extended-canvas indices) whose centre lies in the projection of the plate's in-foil part.
+func footprint(cx: Double, cy: Double, cz: Double, n: (Double, Double, Double), R: Double, t: Double,
+               m: Int, We: Int, He: Int, into fp: inout [Int]) {
+    fp.removeAll(keepingCapacity: true)
+    let tau = pixelNm
+    let wlo = -cz, whi = t - cz               // allowed z - cz
+    let i0 = Int(((cx - R) / pixelNm).rounded(.down)) - 1, i1 = Int(((cx + R) / pixelNm).rounded(.up)) + 1
+    let j0 = Int(((cy - R) / pixelNm).rounded(.down)) - 1, j1 = Int(((cy + R) / pixelNm).rounded(.up)) + 1
+    let n2 = n.2, q2 = 1 - n2 * n2
+    for j in j0...j1 {
+        let py = j + m
+        if py < 0 || py >= He { continue }
+        let dy = (Double(j) + 0.5) * pixelNm - cy
+        for i in i0...i1 {
+            let px = i + m
+            if px < 0 || px >= We { continue }
+            let dx = (Double(i) + 0.5) * pixelNm - cx
+            let e = n.0 * dx + n.1 * dy
+            var lo = wlo, hi = whi
+            if abs(n2) < 1e-12 {
+                if abs(e) > tau / 2 { continue }
+            } else {   // |e + n2 w| <= tau/2
+                let a = (-tau / 2 - e) / n2, b = (tau / 2 - e) / n2
+                lo = max(lo, min(a, b)); hi = min(hi, max(a, b))
+            }
+            if lo > hi { continue }
+            // in-plane squared radius g(w) = (dx^2+dy^2-e^2) + q2 w^2 - 2 e n2 w, convex in w
+            let w = q2 > 1e-12 ? min(max(e * n2 / q2, lo), hi) : lo
+            let g = (dx * dx + dy * dy - e * e) + q2 * w * w - 2 * e * n2 * w
+            if g <= R * R { fp.append(py * We + px) }
+        }
+    }
+}
+
+// MARK: - One seed
+
+struct SeedResult {
+    var counted = 0, edge = 0, accepted = 0, rejected = 0, invisible = 0
+    var ratio = Double.nan, naive = Double.nan
+    var sigma = Double.nan, sigmaP = Double.nan, sigmaL = Double.nan
+    var covered = false
+}
+
+func runSeed(_ cell: Cell, seedIndex: Int) -> SeedResult {
+    let t = cell.t, s = sFactor(cell.cls)
+    var rng = SplitMix64(state: UInt64(cell.index) &* 0x100000001B3 &+ UInt64(seedIndex) &* 0xD6E8FEB86659FD93 &+ 0x1234_5678)
+    _ = rng.next(); _ = rng.next()
+    let dCap = capFactor * cell.dbar, RCap = (cell.cv == 0 ? cell.dbar : dCap) / 2
+    let vCap = (fieldNm + dCap) * (fieldNm + dCap) * (t + s * dCap)
+    let sg = log(1 + cell.cv * cell.cv).squareRoot(), mu = log(cell.dbar) - sg * sg / 2
+
+    let m = Int((RCap / pixelNm).rounded(.up)) + 2
+    let We = W + 2 * m, He = H + 2 * m
+    var occupied = [Bool](repeating: false, count: We * He)
+    var occupiedCount = 0
+    let target = Int((coverageTarget * Double(W * H)).rounded(.up))
+    var res = SeedResult()
+    var fp: [Int] = []
+    fp.reserveCapacity(8192)
+    let inv3 = 1.0 / 3.0.squareRoot()
+    var truthSum = 0.0
+
+    while occupiedCount < target {
+        var d = cell.dbar
+        if cell.cv > 0 {
+            while true {
+                d = exp(mu + sg * rng.gaussian())
+                if d > dCap { continue }
+                let v = (fieldNm + d) * (fieldNm + d) * (t + s * d)
+                if rng.uniform() <= v / vCap { break }
+            }
+        }
+        let R = d / 2, h = s * d
+        let cx = -R + rng.uniform() * (fieldNm + 2 * R)
+        let cy = -R + rng.uniform() * (fieldNm + 2 * R)
+        let cz = -h / 2 + rng.uniform() * (t + h)
+        let bits = rng.next()
+        let n: (Double, Double, Double)
+        if cell.cls == .thetaPrime {
+            switch bits & 3 { case 0: n = (1, 0, 0); case 1: n = (-1, 0, 0); case 2: n = (0, 1, 0); default: n = (0, -1, 0) }
+        } else {
+            n = ((bits & 1 == 0 ? 1 : -1) * inv3, (bits & 2 == 0 ? 1 : -1) * inv3, inv3)
+        }
+        footprint(cx: cx, cy: cy, cz: cz, n: n, R: R, t: t, m: m, We: We, He: He, into: &fp)
+        var clash = false
+        outer: for idx in fp {
+            let r = idx / We, c = idx % We
+            for dr in -1...1 {
+                let rr = r + dr
+                if rr < 0 || rr >= He { continue }
+                for dc in -1...1 {
+                    let cc = c + dc
+                    if cc < 0 || cc >= We { continue }
+                    if occupied[rr * We + cc] { clash = true; break outer }
+                }
+            }
+        }
+        if clash { res.rejected += 1; continue }
+        res.accepted += 1
+        truthSum += 1 / ((fieldNm + 2 * R) * (fieldNm + 2 * R) * (t + h))
+        if fp.isEmpty { res.invisible += 1 }
+        for idx in fp {
+            occupied[idx] = true
+            let r = idx / We - m, c = idx % We - m
+            if r >= 0 && r < H && c >= 0 && c < W { occupiedCount += 1 }
+        }
+    }
+
+    var labels = [Int32](repeating: 0, count: W * H)
+    for r in 0..<H { for c in 0..<W where occupied[(r + m) * We + (c + m)] { labels[r * W + c] = 1 } }
+    let map = PrecipitateSegmentation.classObjects(
+        labels: labels, width: W, height: H,
+        roles: .init(precipitateClasses: [1], matrix: [0], notIndexed: []), pixelSize: pixelNm, pixelUnit: "nm")
+    precondition(map.classes.count == 1, "expected one class")
+    let cls = map.classes[0]
+    precondition(cls.pixelCount == occupiedCount, "object pixels \(cls.pixelCount) != occupied \(occupiedCount)")
+    let counted = cls.objects.filter { !$0.touchesEdge }
+    res.counted = counted.count
+    res.edge = cls.objects.count - counted.count
+    guard !counted.isEmpty else { return res }
+    let plate: PrecipitateNumberDensity.PlateClass = cell.cls == .thetaPrime ? .thetaPrimeEdgeOn : .t1On111
+    let est = try! PrecipitateNumberDensity.estimate(
+        objects: cls.objects, analysedPixels: map.analysedPixels, frameWidth: W, frameHeight: H, pixelSizeNm: pixelNm,
+        thickness: .init(nm: t, sigmaNm: 0, source: .assumed), plate: plate)
+    precondition(est.countedObjects == counted.count)
+    let A = Double(map.analysedPixels) * pixelNm * pixelNm
+    res.ratio = est.numberDensityPerNm3 / truthSum
+    res.naive = (Double(counted.count) / (A * t)) / truthSum
+    res.sigmaP = est.sigmaPoissonPerNm3 / truthSum; res.sigmaL = est.sigmaLengthPerNm3 / truthSum
+    res.sigma = est.sigmaTotalPerNm3 / truthSum
+    res.covered = abs(res.ratio - 1) <= res.sigma
+    return res
+}
+
+// MARK: - One cell
+
+struct CellSummary {
+    var cell: Cell
+    var seeds = 0, hitCap = false
+    var counted = 0.0, edge = 0.0, rej = 0.0, invisible = 0.0
+    var mean = 0.0, sem = 0.0, naive = 0.0, naiveSem = 0.0, sigmaMean = 0.0, coverage = 0.0
+    var pred = 0.0
+}
+func stats(_ x: [Double]) -> (Double, Double) {
+    let n = Double(x.count), m = x.reduce(0, +) / n
+    let v = x.reduce(0) { $0 + ($1 - m) * ($1 - m) } / (n - 1)
+    return (m, (v / n).squareRoot())
+}
+func runCell(_ cell: Cell) -> CellSummary {
+    var ratios: [Double] = [], naives: [Double] = [], sigmas: [Double] = [], cov = 0
+    var cnt = 0, edge = 0, acc = 0, rej = 0, inv = 0
+    var n = 0, cap = false
+    while true {
+        let r = runSeed(cell, seedIndex: n)
+        n += 1
+        cnt += r.counted; edge += r.edge; acc += r.accepted; rej += r.rejected; inv += r.invisible
+        if r.ratio.isFinite { ratios.append(r.ratio); naives.append(r.naive); sigmas.append(r.sigma); if r.covered { cov += 1 } }
+        if n >= minSeeds && ratios.count >= 2 && stats(ratios).1 <= semTarget && stats(naives).1 <= semTarget { break }
+        if n >= maxSeeds { cap = true; break }
+    }
+    var s = CellSummary(cell: cell)
+    s.seeds = n; s.hitCap = cap
+    s.counted = Double(cnt) / Double(n); s.edge = Double(edge) / Double(n)
+    s.rej = Double(rej) / Double(max(acc + rej, 1)); s.invisible = Double(inv) / Double(max(acc, 1))
+    (s.mean, s.sem) = stats(ratios); (s.naive, s.naiveSem) = stats(naives)
+    s.sigmaMean = sigmas.reduce(0, +) / Double(sigmas.count)
+    s.coverage = Double(cov) / Double(ratios.count)
+    s.pred = predicted(cell)
+    return s
+}
+
+// MARK: - Main
+
+@main
+struct NumberDensityHarness {
+    static func main() {
+        let start = Date()
+        var cells: [Cell] = []
+        for cls in [PlateClass.thetaPrime, .t1] { for cv in [0.0, 0.3, 0.6] { for d in [20.0, 100, 190] { for t in [50.0, 100, 200] {
+            cells.append(Cell(cls: cls, dbar: d, t: t, cv: cv, index: cells.count))
+        } } } }
+        if let only = env["T6_CELLS"] {   // debugging: comma list of indices
+            let keep = Set(only.split(separator: ",").compactMap { Int($0) }); cells = cells.filter { keep.contains($0.index) }
+        }
+        let box = ResultBox(count: cells.count)
+        let queue = OperationQueue(); queue.maxConcurrentOperationCount = jobs
+        for (i, c) in cells.enumerated() { queue.addOperation { box.set(i, runCell(c)) } }
+        queue.waitUntilAllOperationsAreFinished()
+        let results = box.all()
+
+        print("N_V synthetic foil, field \(Int(fieldNm)) nm, pixel \(pixelNm) nm (\(W)x\(H)), ratio = N_V estimate / true N_V (sigma_t = 0)")
+        print("bar |mean-1| <= \(passBar); P3 band |mean - table| <= 0.05; seeds >= \(minSeeds) until SEM <= \(semTarget) (ratio and naive), cap \(maxSeeds)")
+        var p1Fail = 0, p2Inside = 0, p3Out = 0, naivePass = 0, covFail = 0, bandOut = 0
+        for r in results {
+            let c = r.cell
+            let ok = abs(r.mean - 1) <= passBar
+            let band = abs(r.mean - r.pred) <= 0.05
+            let naiveOK = abs(r.naive - 1) <= passBar
+            let tag: String
+            var notes: [String] = []
+            if c.cv == 0 && c.dbar / c.t <= 1 { tag = "P1"; if !ok { p1Fail += 1; notes.append("P1 REFUTED") } }
+            else if c.cv == 0 && c.cls == .thetaPrime && c.dbar >= 100 && c.t == 50 { tag = "P2"; if ok { p2Inside += 1; notes.append("P2 REFUTED") } }
+            else { tag = "  " }
+            if c.cv > 0 { if !band { p3Out += 1; notes.append("P3 band MISS") } }
+            if !band { bandOut += 1 }
+            if c.dbar >= 100 && naiveOK { naivePass += 1; notes.append("P4 REFUTED (naive passes)") }
+            let cvg = (abs(r.mean - 1) < 0.02) ? String(format: " cov=%.2f", r.coverage) : ""
+            if abs(r.mean - 1) < 0.02 && r.coverage < 0.60 { covFail += 1; notes.append("COVERAGE <60%") }
+            print(String(format: "%@ %@ cv=%.1f d=%3d t=%3d seeds=%3d%@ cnt=%6.1f edge=%5.1f rej=%4.1f%% invis=%4.2f%% | pred %.3f  mean %.3f+-%.3f %@ band %@ | naive %.3f+-%.3f %@ | sigma/N %.3f%@ %@",
+                         tag as NSString, c.cls.rawValue as NSString, c.cv, Int(c.dbar), Int(c.t), r.seeds, (r.hitCap ? "*" : " ") as NSString,
+                         r.counted, r.edge, 100 * r.rej, 100 * r.invisible, r.pred, r.mean, r.sem,
+                         (ok ? "PASS" : "FAIL") as NSString, (band ? "ok" : "OUT") as NSString,
+                         r.naive, r.naiveSem, (naiveOK ? "pass" : "fail") as NSString, r.sigmaMean, cvg as NSString,
+                         notes.joined(separator: "; ") as NSString))
+        }
+        print("(* = hit the seed cap before SEM target)")
+        print("SUMMARY P1 refutations \(p1Fail); P2 cells inside bar \(p2Inside); P3 band misses (CV>0) \(p3Out); all-cell band misses \(bandOut); naive passing a d>=100 cell \(naivePass); coverage failures \(covFail)")
+        print("VERDICT registered gate: \(results.allSatisfy { abs($0.mean - 1) <= passBar } ? "PASS" : "FAIL") (bar applied to every cell; per-cell lines above)")
+        print(String(format: "runtime %.1f s", Date().timeIntervalSince(start)))
+    }
+}
+
+final class ResultBox: @unchecked Sendable {
+    private var items: [CellSummary?]
+    private let lock = NSLock()
+    init(count: Int) { items = Array(repeating: nil, count: count) }
+    func set(_ i: Int, _ v: CellSummary) { lock.lock(); items[i] = v; lock.unlock() }
+    func all() -> [CellSummary] { items.map { $0! } }
+}
